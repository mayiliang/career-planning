{
  "name": "@career-atlas/server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:unit": "vitest run",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "backup:create": "tsx src/cli/backup-create.ts"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "@fastify/cors": "^10.0.1",
    "drizzle-orm": "^0.38.3",
    "better-sqlite3": "^11.8.1",
    "zod": "^3.24.1",
    "uuid": "^11.0.3",
    "dotenv": "^16.4.7",
    "@career-atlas/content-parser": "workspace:*",
    "@career-atlas/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "~5.7.2",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8",
    "drizzle-kit": "^0.30.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.17.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0"
  }
}
