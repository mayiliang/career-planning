{
  "name": "@career-atlas/web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm materials:check && pnpm pronunciation:check && vue-tsc --noEmit && vite build && node scripts/check-bundle-budget.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 41731",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "materials:check": "node scripts/check-learning-materials.mjs",
    "pronunciation:check": "node scripts/check-pronunciations.mjs",
    "pronunciation:generate": "pwsh -NoLogo -NoProfile -File scripts/generate-pronunciations.ps1",
    "lint": "eslint src --ext .vue,.ts,.tsx",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@mdit/plugin-katex": "^1.0.2",
    "@tanstack/vue-query": "^5.62.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vueuse/core": "^12.0.0",
    "dompurify": "^3.4.12",
    "element-plus": "^2.9.1",
    "highlight.js": "^11.11.1",
    "katex": "^0.18.1",
    "markdown-it": "^15.0.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.16.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@testing-library/vue": "^8.1.0",
    "@types/markdown-it": "^14.1.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "typescript": "~5.7.2",
    "unplugin-auto-import": "^0.18.6",
    "unplugin-vue-components": "^0.27.5",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  }
}
