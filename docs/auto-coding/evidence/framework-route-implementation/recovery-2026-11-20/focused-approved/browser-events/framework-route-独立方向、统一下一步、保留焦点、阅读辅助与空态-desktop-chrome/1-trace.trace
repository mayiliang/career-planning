":"level-3"},"列表重排时让草稿跟着资料走"],["BUTTON",{"data-v-765dde2a":"","type":"button","class":"level-3"},"异步回调要说明何时才算完成"],["BUTTON",{"data-v-765dde2a":"","type":"button","class":"level-3"},"空态错误和只读模式也属于组件的输入"],["BUTTON",{"data-v-765dde2a":"","type":"button","class":"level-3"},"拆分的价值是减少隐含关系"],["BUTTON",{"data-v-765dde2a":"","type":"button","class":"level-3"},"参考与延伸阅读"],""]],["ARTICLE",{"__playwright_target__":"","data-v-765dde2a":"","class":"material-sheet","data-material-path":"/knowledge/materials/react-02-component-boundaries-data-flow-composition.md/react-02","data-reader-ready":"true"},["DIV",{"data-v-765dde2a":"","class":"chapter-intro"},["SPAN",{"data-v-765dde2a":""},"这一篇，读懂一个问题"],["H2",{"data-v-765dde2a":""},"拆开页面之后，每份数据和每个动作由谁负责？"],["UL",{"data-v-765dde2a":""},"",["LI",{"data-v-765dde2a":""},"沿父子组件追踪数据和修改意图"],["LI",{"data-v-765dde2a":""},"用 children 与 render prop 留出明确内容位置"],["LI",{"data-v-765dde2a":""},"处理列表身份和异步回调的完成边界"],""]],["DIV",{"data-v-949f2829":"","data-v-765dde2a":"","class":"markdown-renderer reader-content"},["ARTICLE",{"data-v-949f2829":"","class":"markdown-body","aria-label":"Markdown 内容","data-pronunciations":"ready"},["H2",{"id":"react-02-组件边界数据流与组合"},"REACT-02 组件边界、数据流与组合"],"\n",["P",{},"资料列表左边有搜索框，中间有条目，右边有详情。把它们拆成三个文件很容易，难的是回答：搜索词放在哪里？点击条目后谁改变选择？详情里的草稿应不应该跟列表同时更新？"],"\n",["P",{},"这一篇先把一个小型资料工作台完整写出来，再沿数据的来去理解组件边界。目标不是尽量增加组件数量，而是让每份数据、每个用户动作和每块可替换内容都有清楚的去处。"],"\n",["H3",{"id":"学习前先确认"},"学习前先确认"],"\n",["UL",{},"\n",["LI",{},"直接前置：",["A",{"href":"/knowledge/materials/react-01-render-purity-state-snapshot.md/react-01"},"REACT-01 渲染、组件纯度与状态快照",["SPAN",{"class":"material-reading-badge","data-state":"completed"},"已看完"]],"。其中的快照、更新队列与组件身份会继续用到。"],"\n"],"\n",["P",{},"每段 TSX 都是独立示例，可替换已有 React + TypeScript 项目的 ",["CODE",{},"App.tsx"],"；所需组件、数据和导入均在同一段中。实际工程可以再按名字拆文件。先读完整的数据流，再拆文件，更容易看懂边界。"],"\n",["H3",{"id":"先为工作台里的数据找主人"},"先为工作台里的数据找主人"],"\n",["P",{},"先约定产品行为：搜索只改变列表范围，不清空已经选中的资料；选中项即使暂时被筛掉，右侧仍能查看。这个决定要写在设计里，不能让某个 Effect 偶然决定。"],"\n",["TABLE",{},"\n",["THEAD",{},"\n",["TR",{},"\n",["TH",{},"数据或动作"],"\n",["TH",{},"谁拥有"],"\n",["TH",{},"为什么"],"\n"],"\n"],"\n",["TBODY",{},"\n",["TR",{},"\n",["TD",{},"关键词"],"\n",["TD",{},"工作台"],"\n",["TD",{},"搜索框要修改，列表要读取"],"\n"],"\n",["TR",{},"\n",["TD",{},"选中资料 ID"],"\n",["TD",{},"工作台"],"\n",["TD",{},"列表发起选择，详情显示同一选择"],"\n"],"\n",["TR",{},"\n",["TD",{},"筛选后的列表"],"\n",["TD",{},"不另存 state"],"\n",["TD",{},"根据原列表和关键词计算"],"\n"],"\n",["TR",{},"\n",["TD",{},"详情里的临时草稿"],"\n",["TD",{},"编辑器，或需要保留草稿的上层"],"\n",["TD",{},"看是否要跨资料切换保留"],"\n"],"\n",["TR",{},"\n",["TD",{},"每行按钮的 DOM 事件"],"\n",["TD",{},"行组件内部"],"\n",["TD",{},"父层只需要知道用户选了哪个 ID"],"\n"],"\n"],"\n"],"\n",["P",{},"这张表先回答所有权，再决定组件。页面上有几个矩形，不能直接告诉你状态应放在哪一层。两个相距很远的区域可能共享同一事实；紧挨着的两个按钮也可能属于不同任务。"],"\n",["H3",{"id":"用完整组件追踪数据下行与意图上行"},"用完整组件追踪数据下行与意图上行"],"\n",["P",{},"运行这个工作台，选择“状态快照”，再搜索“表单”。列表只留下表单，详情仍显示状态快照；清空搜索后，原选择重新出现在列表中。"],"\n",["DIV",{"class":"code-block","data-language":"tsx"},["DIV",{"class":"code-block__bar"},["SPAN",{},"tsx"],["BUTTON",{"type":"button","class":"code-copy"},"复制代码"]],["PRE",{"class":"hljs"},["CODE",{},["SPAN",{"class":"hljs-keyword"},"import"]," { useId, useState } ",["SPAN",{"class":"hljs-keyword"},"from"]," ",["SPAN",{"class":"hljs-string"},"'react'"],";\n\n",["SPAN",{"class":"hljs-keyword"},"type"]," ",["SPAN",{"class":"hljs-title class_"},"Lesson"]," = ",["SPAN",{"class":"hljs-title class_"},"Readonly"],"<{ ",["SPAN",{"class":"hljs-attr"},"id"],": ",["SPAN",{"class":"hljs-built_in"},"string"],"; ",["SPAN",{"class":"hljs-attr"},"title"],": ",["SPAN",{"class":"hljs-built_in"},"string"],"; ",["SPAN",{"class":"hljs-attr"},"minutes"],": ",["SPAN",{"class":"hljs-built_in"},"number"]," }>;\n",["SPAN",{"class":"hljs-keyword"},"const"]," ",["SPAN",{"class":"hljs-attr"},"lessons"],": ",["SPAN",{"class":"hljs-keyword"},"readonly"]," ",["SPAN",{"class":"hljs-title class_"},"Lesson"],"[] = [\n  { ",["SPAN",{"class":"hljs-attr"},"id"],": ",["SPAN",{"class":"hljs-string"},"'form'"],", ",["SPAN",{"class":"hljs-attr"},"title"],": ",["