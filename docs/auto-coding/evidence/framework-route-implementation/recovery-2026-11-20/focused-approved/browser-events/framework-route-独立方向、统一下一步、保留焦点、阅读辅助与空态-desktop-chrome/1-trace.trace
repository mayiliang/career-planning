lass":"hljs-string"},"\"status\""],">"],"{message}",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"p"],">"],"\n    ",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"form"],">"]],"\n  );\n}\n",["SPAN",{"class":"hljs-keyword"},"export"]," ",["SPAN",{"class":"hljs-keyword"},"default"]," ",["SPAN",{"class":"hljs-keyword"},"function"]," ",["SPAN",{"class":"hljs-title function_"},"App"],"(",["SPAN",{"class":"hljs-params"}],") {\n  ",["SPAN",{"class":"hljs-keyword"},"const"]," [saved, setSaved] = ",["SPAN",{"class":"hljs-title function_"},"useState"],"(",["SPAN",{"class":"hljs-string"},"'尚未保存'"],");\n  ",["SPAN",{"class":"hljs-keyword"},"async"]," ",["SPAN",{"class":"hljs-keyword"},"function"]," ",["SPAN",{"class":"hljs-title function_"},"save"],"(",["SPAN",{"class":"hljs-params"},["SPAN",{"class":"hljs-attr"},"title"],": ",["SPAN",{"class":"hljs-built_in"},"string"]],") {\n    ",["SPAN",{"class":"hljs-keyword"},"await"]," ",["SPAN",{"class":"hljs-keyword"},"new"]," ",["SPAN",{"class":"hljs-title class_"},"Promise"],"<",["SPAN",{"class":"hljs-built_in"},"void"],">(",["SPAN",{"class":"hljs-function"},["SPAN",{"class":"hljs-params"},"resolve"]," =>"]," ",["SPAN",{"class":"hljs-built_in"},"setTimeout"],"(resolve, ",["SPAN",{"class":"hljs-number"},"200"],"));\n    ",["SPAN",{"class":"hljs-keyword"},"if"]," (title.",["SPAN",{"class":"hljs-property"},"length"]," < ",["SPAN",{"class":"hljs-number"},"2"],") ",["SPAN",{"class":"hljs-keyword"},"throw"]," ",["SPAN",{"class":"hljs-keyword"},"new"]," ",["SPAN",{"class":"hljs-title class_"},"Error"],"(",["SPAN",{"class":"hljs-string"},"'标题至少需要两个字符'"],");\n    ",["SPAN",{"class":"hljs-title function_"},"setSaved"],"(title);\n  }\n  ",["SPAN",{"class":"hljs-keyword"},"return"]," ",["SPAN",{"class":"language-xml"},["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"main"],">"],["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"h1"],">"],"修改资料标题",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"h1"],">"],["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"RenameForm"]," ",["SPAN",{"class":"hljs-attr"},"onSave"],"=",["SPAN",{"class":"hljs-string"},"{save}"]," />"],["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"p"],">"],"已保存标题：{saved}",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"p"],">"],["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"main"],">"]],";\n}\n"]],"\n"],["P",{},"输入一个字符再保存，会得到错误且文本仍在；改成“组件协作”再保存，父层的已保存标题改变。等待期间禁用输入和按钮，避免这个简化场景里草稿在提交途中又发生变化。"],"\n",["P",{},"父层若启动异步请求却忘了 return 或 await，子层就会过早以为完成。类型写成 Promise 有助于发现签名问题，实际实现也要遵守等待关系。这个基础来自 ",["A",{"href":"/knowledge/materials/js-05-promise-errors-async-control-flow.md/js-05#%E8%B0%83%E7%94%A8%E6%96%B9%E7%AD%89%E5%BE%85%E7%9A%84%E7%A9%B6%E7%AB%9F%E6%98%AF%E5%93%AA%E4%B8%80%E4%BB%B6%E4%BA%8B"},"JS-05 的异步等待边界",["SPAN",{"class":"material-reading-badge","data-state":"unread"},"未读"]],"。跨实体切换、取消与并发保存则需要额外身份判断，不能仅凭 saving 就推断所有异步都安全。"],"\n",["H3",{"id":"空态错误和只读模式也属于组件的输入"},"空态错误和只读模式也属于组件的输入"],"\n",["P",{},"只有成功数据时才知道怎样渲染的组件，通常会让调用者在每个角落补条件。先确定加载中、无结果、失败、只读时分别由谁提供内容和动作，再决定 API。"],"\n",["P",{},"互斥模式可以用判别联合表达，参见 ",["A",{"href":"/knowledge/materials/ts-02-unions-narrowing-never-exhaustiveness.md/ts-02#%E5%88%A4%E5%88%AB%E8%81%94%E5%90%88%E6%8A%8A%E4%B8%80%E4%B8%AA%E7%8A%B6%E6%80%81%E5%92%8C%E5%AE%83%E9%9C%80%E8%A6%81%E7%9A%84%E6%95%B0%E6%8D%AE%E6%94%BE%E5%9C%A8%E4%B8%80%E8%B5%B7"},"TS-02 的判别联合",["SPAN",{"class":"material-reading-badge","data-state":"unread"},"未读"]],"。例如编辑模式要求 onSave，只读模式不提供保存操作，比 editable、hideActions、disabled 等一组可能互相冲突的布尔值更容易理解。"],"\n",["P",{},"但也不必把请求状态全部塞进最底层行组件。父层可以负责加载或错误分支，列表专心显示已经可用的数据；也可以用前面的组合容器统一状态区域。区别在于调用者是否仍能明确控制恢复路径。"],"\n",["P",{},"隐藏按钮只是呈现层的权限体验，实际写入仍由可信服务端授权。组件不能因为没有显示“删除”就声称数据无法被删除。"],"\n",["H3",{"id":"拆分的价值是减少隐含关系"},"拆分的价值是减少隐含关系"],"\n",["P",{},"判断边界是否合适，可以尝试只拿组件公开的 props、回调和内容位置，解释它的行为。如果还必须知道某个路由全局变量、某个兄弟组件的私有 ref 或某段隐藏 Effect，说明依赖尚未表达完整。"],"\n",["P",{},"组件拆小不保证不再渲染。父层变化仍可能让子组件重新计算；不要为避免一次便宜的 render 把每个标签单独包装。把临时输入放在合理的拥有者，减少冗余数据，再在确有成本时研究性能，比一开始到处 memo 更有效。"],"\n",["P",{},"错误边界和 Suspense 也应服务于可独立恢复的用户任务，而不是每个小块都套一个 fallback。普通 Error Boundary 不会自动捕获事件处理器里的所有异步失败，保存错误仍要在相应流程处理。后续异步边界资料会展开这一点。"],"\n",["P",{},"当公共组件被多个页面使用时，事件参数、回调完成时机、默认值、属性落点和可访问名称都是调用者依赖的行为。改了它们，应同步修改代表性用法与说明。这里的必要核对是“输入什么、操作什么、得到什么”，不是固定内部 Hook 次数或文件层级。"],"\n",["H3",{"id":"参考与延伸阅读"},"参考与延伸阅读"],"\n",["UL",{},"\n",["LI",{},["A",{"href":"https://react.dev/learn/passing-props-to-a-component","target":"_blank","rel":"noopener noreferrer"},"React：Passing Props to a Component"],"：查 props、默认值与 children。"],"\n",["LI",{},["A",{"href":"https://react.dev/learn/sharing-state-between-components","target":"_blank","rel":"noopener noreferrer"},"React：Sharing State Between Components"],"：查共同拥有者和受控组件。"],"\n",["LI",{},["A",{"href":"https://react.dev/learn/rendering-lists","target":"_blank","rel":"noopener noreferrer"},"React：Rendering Lists"],"：查列表 key 与稳定身份。"],"\n",["LI",{},["A",{"href":"https://react.dev/reference/react/useId","target":"_blank","rel":"noopener noreferrer"},"React：useId"],"：查可访问性 ID 与列表 key 的不同用途。"],"\n",["LI",{},["A",{"href":"https://react.dev/learn/thinking-in-react","target":"_blank","rel":"noopener noreferrer"},"React：Thinking in React"],"：继续练习从数据、状态与组件关系构建页面。"],"\n"],"\n"]],["NAV",{"data-v-765dde2a":"","class":"chapter-pagination","aria-label":"继续学习"},["A",{"data-v-765dde2a":"","href":"/knowledge/materials/vue-03-template-directives-events-forms.md/vue-03","class":""},["SMALL",{"data-v-765dde2a":""},"同组下一篇 →"],["STRONG",{"data-v-765dde2a":""},"Vue 模板与表单"]]],["FOOTER",{"data-v-765dde2a":""},["SPAN",{"data-v-765dde2a":""},"正文阅读超过 80% 仅标记资料看完，不改变知识点状态"],["BUTTON",{"data-v-765dde2a":"","type":"button"},"返回上一页 →"]],["SPAN",{"data-v-765dde2a":"","class":"pronunciation-feedback","aria-live":"polite"}],["SPAN",{"data-v-765dde2a":"","class":"reading-save-feedback","aria-live":"polite"}]],["ASIDE",{"data-v-765dde2a":"","class":"support-rail"},["SECTION",{"data-v-765dde2a":"","cla