"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"li"]," ",["SPAN",{"class":"hljs-attr"},"key"],"=",["SPAN",{"class":"hljs-string"},"{item.id}"],">"],"{item.title}",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"li"],">"],")}",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"ul"],">"],"\n    ",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"main"],">"]],"\n  );\n}\n"]],"\n"],["P",{},"空关键词显示三篇，输入 ",["CODE",{},"react"]," 只显示状态快照，清空又回到三篇。每次 render 都从这一轮输入算出同一份结果，没有等待 Effect 再补一次列表状态。"],"\n",["P",{},"如果通过 Effect 监听 query 然后调用 ",["CODE",{},"setVisible"],"，就多维护了一个本可直接推导的值，也多了一次同步机会。先判断数据是否真的独立，再考虑是否放进 state。计算昂贵时可以研究缓存与调度，但不要先复制一份状态再解决复制带来的问题。"],"\n",["P",{},"选读（无需先学 Vue）：同样的筛选会在 ",["A",{"href":"/knowledge/materials/vue-02-ref-reactive-computed-boundaries.md/vue-02#computed-%E8%AE%A9%E7%AD%9B%E9%80%89%E7%BB%93%E6%9E%9C%E8%B7%9F%E7%9D%80%E6%BA%90%E7%8A%B6%E6%80%81%E5%8F%98%E5%8C%96"},"VUE-02 的 computed",["SPAN",{"class":"material-reading-badge","data-state":"unread"},"未读"]],"中出现。React 这里重新运行组件中的普通计算；Vue 会跟踪响应式读取并按依赖管理派生计算。它们都应避免无必要地保存两份同义数据。"],"\n",["H3",{"id":"先保证计算正确再理解并发与-hydration"},"先保证计算正确再理解并发与 Hydration"],"\n",["P",{},"并发渲染允许 React 调度、重做或放弃某些渲染工作；并不意味着它能在任意一行 JavaScript 中间抢占你的同步函数。重要的是一次计算可能不进入 commit，所以不能让“函数运行过”本身成为已完成业务操作的证据。"],"\n",["P",{},"输入框回显与很重的结果展示可以有不同优先级。transition 等机制帮助安排工作，不自动取消旧网络请求，也不保证服务器返回顺序正确。异步提交资格仍要结合请求身份判断，本篇先掌握快照和纯度即可。"],"\n",["P",{},"服务端渲染场景还会遇到 ",["STRONG",{},"Hydration"],["BUTTON",{"type":"button","class":"pronunciation-button","data-pronunciation-term":"Hydration","data-pronunciation-src":"/pronunciation/b04/4163fe8dc2507164.wav","aria-label":"播放“Hydration”的美式发音","title":"播放“Hydration”的美式发音"},["SPAN",{"aria-hidden":"true"},"🔊"]],"：客户端接管已有 HTML，并把组件交互与之连接起来。服务端与客户端的初始输出需要匹配。如果 render 随机生成文本、直接读取只在浏览器存在的存储，可能导致初始结果不一致。解决方向是明确初始数据与客户端同步时机，而不是把错误提示隐藏。"],"\n",["P",{},"遇到旧值、重复或草稿错位时，先说清五件事：这次回调来自哪次渲染；队列里是替换还是累积；render 有没有改外部对象；派生值是否重复保存；key 是否表达了正确身份。能够沿这几步说明结果，就有了继续学习 Hooks 与性能优化所需的基础。"],"\n",["P",{},"类型写法就地理解：",["CODE",{},"{ title: string; minutes: number }"]," 约定两个字段；",["CODE",{},"useState<0 | 1>"]," 限定只能保存 0 或 1；",["CODE",{},"defineProps<{ ... }>()"]," 声明组件输入类型。使用这些声明不要求先完成 TS-03 的泛型设计、keyof 与索引访问。TS-01 可作为类型记号的推荐补读，TS-03 属于深入学习。"],"\n",["H3",{"id":"参考与延伸阅读"},"参考与延伸阅读"],"\n",["UL",{},"\n",["LI",{},["A",{"href":"https://react.dev/learn/render-and-commit","target":"_blank","rel":"noopener noreferrer"},"React：Render and Commit"],"：查触发、渲染、提交与 DOM 更新的区别。"],"\n",["LI",{},["A",{"href":"https://react.dev/learn/state-as-a-snapshot","target":"_blank","rel":"noopener noreferrer"},"React：State as a Snapshot"],"：查事件处理器与某次渲染状态的关系。"],"\n",["LI",{},["A",{"href":"https://react.dev/learn/queueing-a-series-of-state-updates","target":"_blank","rel":"noopener noreferrer"},"React：Queueing a Series of State Updates"],"：查替换值、更新函数及队列顺序。"],"\n",["LI",{},["A",{"href":"https://react.dev/learn/keeping-components-pure","target":"_blank","rel":"noopener noreferrer"},"React：Keeping Components Pure"],"：查输入、局部变更与纯度边界。"],"\n",["LI",{},["A",{"href":"https://react.dev/reference/react/StrictMode","target":"_blank","rel":"noopener noreferrer"},"React：StrictMode"],"：查开发检查与具体启用范围。"],"\n",["LI",{},["A",{"href":"https://react.dev/learn/preserving-and-resetting-state","target":"_blank","rel":"noopener noreferrer"},"React：Preserving and Resetting State"],"：查树位置与 key 对状态的影响。"],"\n"],"\n"]],["NAV",{"data-v-765dde2a":"","class":"chapter-pagination","aria-label":"继续学习"},["A",{"data-v-765dde2a":"","href":"/knowledge/materials/web-01-html-semantics-forms-accessibility.md/web-01","class":""},["SMALL",{"data-v-765dde2a":""},"← 同组上一篇"],["STRONG",{"data-v-765dde2a":""},"HTML 语义与表单"]],["A",{"data-v-765dde2a":"","href":"/knowledge/materials/vue-01-vite-sfc-project-structure.md/vue-01","class":""},["SMALL",{"data-v-765dde2a":""},"同组下一篇 →"],["STRONG",{"data-v-765dde2a":""},"Vue 项目与 SFC"]]],["FOOTER",{"data-v-765dde2a":""},["SPAN",{"data-v-765dde2a":""},"正文阅读超过 80% 仅标记资料看完，不改变知识点状态"],["BUTTON",{"data-v-76