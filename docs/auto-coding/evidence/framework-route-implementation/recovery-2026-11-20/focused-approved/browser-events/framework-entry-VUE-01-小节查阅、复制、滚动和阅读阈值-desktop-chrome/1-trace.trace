eyword"},"from"]," ",["SPAN",{"class":"hljs-string"},"'vue'"],";\n",["SPAN",{"class":"hljs-keyword"},"import"]," ",["SPAN",{"class":"hljs-title class_"},"App"]," ",["SPAN",{"class":"hljs-keyword"},"from"]," ",["SPAN",{"class":"hljs-string"},"'./App.vue'"],";\n\n",["SPAN",{"class":"hljs-title function_"},"createApp"],"(",["SPAN",{"class":"hljs-title class_"},"App"],").",["SPAN",{"class":"hljs-title function_"},"mount"],"(",["SPAN",{"class":"hljs-string"},"'#app'"],");\n"]],"\n"],["P",{},["CODE",{},"src/App.vue"],"："],"\n",["DIV",{"class":"code-block","data-language":"vue"},["DIV",{"class":"code-block__bar"},["SPAN",{},"vue"],["BUTTON",{"type":"button","class":"code-copy"},"复制代码"]],["PRE",{"class":"hljs"},["CODE",{},"<script setup lang=\"ts\">\nconst lesson = { title: 'HTML 语义与表单', minutes: 25 };\n</script>\n\n<template>\n  <main class=\"reading-room\">\n    <h1>我的阅读室</h1>\n    <article>\n      <h2>{{ lesson.title }}</h2>\n      <p>预计用时：{{ lesson.minutes }} 分钟</p>\n    </article>\n  </main>\n</template>\n\n<style scoped>\n.reading-room { max-width: 56rem; margin: 3rem auto; padding: 0 2rem; }\narticle { padding: 1.5rem; border: 1px solid #ccdcd3; border-radius: 12px; }\nh2 { margin-top: 0; }\n</style>\n"]],"\n"],["P",{},"页面应显示“我的阅读室”和一张预计 25 分钟的资料卡片。先检查 ",["CODE",{},"index.html"]," 的容器 ID 与 ",["CODE",{},"mount('#app')"]," 是否一致，再看模块导入的文件是否存在，就能定位许多空白页问题。"],"\n",["P",{},"入口链可以写成：浏览器取得 HTML → 加载 ",["CODE",{},"main.ts"]," 对应的模块 → 模块导入 ",["CODE",{},"App.vue"]," 的编译结果 → ",["CODE",{},"createApp"]," 创建应用 → ",["CODE",{},"mount"]," 把组件挂到容器。这是模块加载与组件创建共同完成的过程，不是浏览器直接理解 TypeScript 或 ",["CODE",{},".vue"],"。"],"\n",["P",{},"把 ",["CODE",{},"App.vue"]," 标题改成“本周阅读”，观察页面更新；再把 ",["CODE",{},"mount"]," 的目标误写成不存在的 ID，观察警告和空白结果，最后恢复。这样的对照能说明每个文件的责任，比反复重装依赖更直接。"],"\n",["H3",{"id":"sfc-把同一组件的代码放在一起"},"SFC 把同一组件的代码放在一起"],"\n",["P",{},["STRONG",{},"单文件组件（single-file component",["BUTTON",{"type":"button","class":"pronunciation-button","data-pronunciation-term":"single-file component","data-pronunciation-src":"/pronunciation/b04/7ee45bbe33e454a1.wav","aria-label":"播放“single-file component”的美式发音","title":"播放“single-file component”的美式发音"},["SPAN",{"aria-hidden":"true"},"🔊"]],"）"]," 通常简称 ",["STRONG",{},"SFC"],["BUTTON",{"type":"button","class":"pronunciation-button","data-pronunciation-term":"SFC","data-pronunciation-src":"/pronunciation/b04/a56068c3ca600241.wav","aria-label":"播放“SFC”的美式发音","title":"播放“SFC”的美式发音"},["SPAN",{"aria-hidden":"true"},"🔊"]],"。一个 ",["CODE",{},".vue"]," 文件把模板、逻辑和样式放在一起，是因为它们共同描述同一个组件。"],"\n",["TABLE",{},"\n",["THEAD",{},"\n",["TR",{},"\n",["TH",{},"区块"],"\n",["TH",{},"写什么"],"\n",["TH",{},"处理后去哪里"],"\n"],"\n"],"\n",["TBODY",{},"\n",["TR",{},"\n",["TD",{},"template"],"\n",["TD",{},"页面结构、文本与绑定"],"\n",["TD",{},"编译成 Vue 可执行的渲染逻辑"],"\n"],"\n",["TR",{},"\n",["TD",{},"script setup"],"\n",["TD",{},"导入、实例内逻辑与暴露给模板的绑定"],"\n",["TD",{},"转成组件的 setup 相关代码"],"\n"],"\n",["TR",{},"\n",["TD",{},"style"],"\n",["TD",{},"组件样式"],"\n",["TD",{},"由构建工具处理并交给浏览器"],"\n"],"\n"],"\n"],"\n",["P",{},"模板的双大括号插入文本，冒号如 ",["CODE",{},":minutes=\"25\""]," 绑定表达式，",["CODE",{},"@click"]," 绑定事件处理。这些是 Vue 模板语法，最终仍要得到普通 DOM。SFC 的存在没有改变 ",["A",{"href":"/knowledge/materials/web-01-html-semantics-forms-accessibility.md/web-01#%E9%93%BE%E6%8E%A5%E8%B4%9F%E8%B4%A3%E5%8E%BB%E5%93%AA%E9%87%8C%E6%8C%89%E9%92%AE%E8%B4%9F%E8%B4%A3%E5%81%9A%E4%BB%80%E4%B9%88"},"HTML 控件语义",["SPAN",{"class":"material-reading-badge","data-state":"unread"},"未读"]],"。"],"\n",["P",{},"这与“把页面所有东西塞进一个文件”不同。一张资料卡片适合独立组件，整套账户系统却不应只因能放进一个 SFC 就放进去。拆分依据是责任和变化，而不是模板超过某个机械行数。"],"\n",["P",{},"也不要把 script setup 当成浏览器生命周期事件。它不等于“页面加载完成后执行”，其中的 DOM 可能还没有挂载。需要读实际节点时，要结合挂载时机与模板引用。"],"\n",["H3",{"id":"模块执行一次与每个实例执行不是一回事"},"模块执行一次与每个实例执行不是一回事"],"\n",["P",{},"在同一模块实例中，普通模块顶层通常只求值一次；组件可以创建多个实例。",["CODE",{},"script setup"]," 中需要按实例执行的逻辑会进入组件 setup，顶层 import 仍属于模块导入。"],"\n",["P",{},"创建 ",["CODE",{},"src/ReadingCard.vue"],"："],"\n",["DIV",{"class":"code-block","data-language":"vue"},["DIV",{"class":"code-block__bar"},["SPAN",{},"vue"],["BUTTON",{"type":"button","class":"code-copy"},"复制代码"]],["PRE",{"class":"hljs"},["CODE",{},"<script setup lang=\"ts\">\nimport { ref } from 'vue';\n\ndefineProps<{ title: string; minutes: number }>();\nconst expanded = ref(false);\n</script>\n\n<template>\n  <article>\n    <h2>{{ title }}</h2>\n    <button type=\"button\" :aria-expanded=\"expanded\" @click=\"expanded = !expanded\">\n      {{ expanded ? '收起说明' : '展开说明' }}\n    </button>\n    <p v-if=\"expanded\">这份资料预计需要 {{ minutes }} 分钟。</p>\n  </article>\n</template>\n"]],"\n"],["P",{},"再将 ",["CODE",{},"src/App.vue"]," 替换为："],"\n",["DIV",{"class":"code-block","data-language":"vue"},["DIV",{"class":"code-block__bar"},["SPAN",{},"vue"],["BUTTON",{"type":"button","class":"code-copy"},"复制代码"]],["PRE",{"class":"hljs"},["CODE",{},"<script setup lang=\"ts\">\nimport ReadingCard from './ReadingCard.vue';\n</script>\n\n<template>\n  <main>\n    <h1>两张独立的资料卡片</h1>\n    <ReadingCard title=\"HTML 表单\" :minutes=\"25\" />\n    <ReadingCard title=\"状态快照\" :minutes=\"30\" />\n  </main>\n</template>\n"]],"\n"],["P",{},"点击第一张卡片的“展开说明”，第二张仍收起。因为 ",["CODE",{},"expanded"]," 在各自 setup 中创建，每个组件实例有自己的 ref。ref(false) 创建初始值为 false 的响应式容器；脚本中用 expanded.value 读写，模板会自动解包，所以模板中 expanded = !expanded 能切换布尔值。v-if 只在为真时创建说明段落；@click 绑定点击处理。更新后 Vue 安排 DOM 更新，不要求你先读 VUE-02 的依赖追踪实现。"],"\n",["P",{},"如果把这个可变 ref 移到单独模块顶层再让两个组件共同导入，就变成共享状态。共享可以是需求，也可以是 bug，区别取决于谁应该拥有这份数据。服务端渲染还涉及多个请求之间的隔离，不能随意把用户状态放进进程共享模块。"],"\n",["P",{},["CODE",{},"defineProps"]," 是编译器宏，不需要从 Vue 导入，也不能当成任意位置都可调用的普通函数。同类宏如 ",["CODE",{},"defineEmits"]," 用于声明组件边界；它们的详细用法在后续组件知识点展开。需要回顾模块绑定与缓存时，阅读 ",["A",{"href":"/knowledge/materials/js-06-es-modules-module-boundaries.md/js-06#%E6%A8%A1%E5%9D%97%E5%9B%BE%E4%B8%8D%E6%98%AF%E6%8A%8A%E4%BB%A3%E7%A0%81%E6%8C%89%E6%96%87%E5%AD%97%E9%A1%BA%E5%BA%8F%E7%B2%98%E8%B5%B7%E6%9D%A5"},"JS-06 的模块求值",["SPAN",{"class":"material-reading-badge","data-state":"unread"},"未读"]],"。"],"\n",["H3",{"id":"vite-开发与生产使用同一份源码但处理方式不同"},"Vite 开发与生产使用同一份源码但处理方式不同"],"\n",["P",{},"开发时，Vite 根据浏览器请求转换源码，并利用模块关系更新受影响部分。改变一个组件，不必把整个生产包重新生成后再刷新页面。依赖还可能经过",["STRONG",{},"依赖预构建（dependency pre-bundling",["BUTTON",{"type":"button","class":"pronunciation-button","data-pronunciation-term":"dependency pre-bundling","data-pronunciation-src":"/pronunciation/b04/4e2f4a14f24c91f6.wav","aria-label":"播放“dependency pre-bundling”的美式发音","title":"播放“dependency pre-bundling”的美式发音"},["SPAN",{"aria-hidden":"true"},"🔊"]],"）"],"，处理模块格式或过多小模块带来的开发加载成本。"],"\n",["P",{},"生产构建会从入口分析依赖图，转换、分块和优化，输出可以部署的 HTML、JavaScript、CSS 与资源。具体内部构建器会随 Vite 版本变化，本篇不把某个实现名字写成永久规则。"],"\n",["P",{},"因此，“开发能运行”与“产物能部署”是相关但不同的结论。例如源码中使用仅开发存在的代理地址，开发访问正常；构建后静态文件并不会随身携带那台代理。又如 Windows 上不易察觉的文件名大小写错误，放到大小写敏感的环境可能导致模块或资源找不到。"],"\n",["P",{},"遇到错误，先判断发生在源码转换、类型检查、模块解析、产物生成，还是浏览器加载阶段。只有确认阶段，下一步查看控制台、终端或网络请求才有方向。"],"\n",["H3",{"id":"目录随职责增长不必一开始就铺满层级"},"目录随职责增长不必一开始就铺满层级"],"\n",["P",{},"刚才三个文件的项目不需要提前创建几十个空目录。功能多起来后，可以围绕一条真实变化路线组织："],"\n",["DIV",{"class":"code-block","data-language":"text"},["DIV",{"class":"code-block__bar"},["SPAN",{},"text"],["BUTTON",{"type":"button","class":"code-copy"},"复制代码"]],["PRE",{"class":"hljs"},["CODE",{},"src/\n  main.ts\n  App.vue\n  app/                    路由与应用装配\n  features/\n    reading/\n      ReadingPage.vue     阅读页面，组合本功能的组件\n      ReadingCard.vue     资料卡片\n      reading-service.ts  本功能的数据读取与解析\n      index.ts            需要对外公开的入口\n  components/             多个业务确实共用的展示组件\n  styles/                 全局颜色、排版与基础样式\n"]],"\n"],["P",{},"“页面”通常负责取得页面需要的参数与数据，并组合功能；“组件”负责可独立理解的一块界面；“服务”把网络响应转换为应用需要的数据。不要仅靠把文件放进 services 就认为外部数据已经可信，解析仍需要实际代码。"],"\n",["P",{},"如果修改一张资料卡片总要穿过全局 components、utils、stores 中很多不相关文件，按业务就近组织可能更容易维护。反过来，一段只使用一次的两行函数，没有必要为了目录整齐拆到公共工具包。"],"\n",["P",{},"跨功能访问优先经过明确入口。别名能缩短路径，却不应让调用方深入另一个功能的内部实现。这里与 ",["A",{"href":"/knowledge/materials/js-06-es-modules-module-boundaries.md/js-06#%E5%85%AC%E5%85%B1%E5%AF%BC%E5%87%BA%E5%BA%94%E8%AF%A5%E5%B0%8F%E4%BA%8E%E5%86%85%E9%83%A8%E5%AE%9E%E7%8E%B0"},"JS-06 的公共导出",["SPAN",{"class":"material-reading-badge","data-state":"unread"},"未读"]],"遵循相同原则。"],"\n",["P",{},"如果项目加入 Router，可以按“main 安装路由 → App 提供路由出口 → 路由表选择页面 → 页面组合组件”继续追踪。页面文件不会因为放进 pages 目录就自动成为路由，具体注册规则由所用工具决定。"],"\n",["H3",{"id":"别名需要让构建工具和类型工具指向同一处"},"别名需要让构建工具和类型工具指向同一处"],"\n",["P",{},"当目录加深，",["CODE",{},"@/features/reading/ReadingPage.vue"]," 比多层 ",["CODE",{},"../../"]," 更容易辨认，但 ",["CODE",{},"@"]," 不是 JavaScript 内置语法。下面是包含 Vue 插件与别名的完整 Vite 配置示意，合并到已有配置时保留项目其他必需插件："],"\n",["DIV",{"class":"code-block","data-language":"ts"},["DIV",{"class":"code-block__bar"},["SPAN",{},"ts"],["BUTTON",{"type":"button","class":"code-copy"},"复制代码"]],["PRE",{"class":"hljs"},["CODE",{},["SPAN",{"class":"hljs-keyword"},"import"]," { fileURLToPath, ",["SPAN",{"class":"hljs-variable constant_"},"URL"]," } ",["SPAN",{"class":"hljs-keyword"},"from"]," ",["SPAN",{"class":"hljs-string"},"'node:url'"],";\n",["SPAN",{"class":"hljs-keyword"},"import"]," { defineConfig } ",["SPAN",{"class":"hljs-keyword"},"from"]," ",["SPAN",{"class":"hljs-string"},"'vite'"],";\n",["SPAN",{"class":"hljs-keyword"},"import"]," vue ",["SPAN",{"class":"hljs-keyword"},"from"]," ",["SPAN",{"class":"hljs-string"},"'@vitejs/plugin-vue'"],";\n\n",["SPAN",{"class":"hljs-keyword"},"export"]," ",["SPAN",{"class":"hljs-keyword"},"default"]," ",["SPAN",{"class":"hljs-title function_"},"defineConfig"],"({\n  ",["SPAN",{"class":"hljs-attr"},"plugins"],": [",["SPAN",{"class":"hljs-title function_"},"vue"],"()],\n  ",["SPAN",{"class":"hljs-attr"},"resolve"],": {\n    ",["SPAN",{"class":"hljs-attr"},"alias"],": { ",["SPAN",{"class":"hljs-string"},"'@'"],": ",["SPAN",{"class":"hljs-title function_"},"fileURLToPath"],"(",["SPAN",{"class":"hljs-keyword"},"new"]," ",["SPAN",{"class":"hljs-title function_"},"URL"],"(",["SPAN",{"class":"hljs-string"},"'./src'"],", ",["SPAN",{"class":"hljs-keyword"},"import"],".",["SPAN",{"class":"hljs-property"},"meta"],".",["SPAN",{"class":"hljs-property"},"url"],")) },\n  },\n});\n"]],"\n"],["P",{},"还要让检查应用源码的 TypeScript 配置解析同一位置。例如在已有 ",["CODE",{},"tsconfig.app.json"]," 的 ",["CODE",{},"compilerOptions"]," 中合并以下内容，而不是把整份生成配置删掉重写："],"\n",["DIV",{"class":"code-block","data-language":"json"},["DIV",{"class":"code-block__bar"},["SPAN",{},"json"],["BUTTON",{"type":"button","class":"code-copy"},"复制代码"]],["PRE",{"class":"hljs"},["CODE",{},["SPAN",{"class":"hljs-punctuation"},"{"],"\n  ",["SPAN",{"class":"hljs-attr"},"\"baseUrl\""],["SPAN",{"class":"hljs-punctuation"},":"]," ",["SPAN",{"class":"hljs-string"},"\".\""],["SPAN",{"class":"hljs-punctuation"},","],"\n  ",["SPAN",{"class":"hljs-attr"},"\"paths\""],["SPAN",{"class":"hljs-punctuation"},":"]," ",["SPAN",{"class":"hljs-punctuation"},"{"]," ",["SPAN",{"class":"hljs-attr"},"\"@/*\""],["SPAN",{"class":"hljs-punctuation"},":"]," ",["SPAN",{"class":"hljs-punctuation"},"["],["SPAN",{"class":"hljs-string"},"\"src/*\""],["SPAN",{"class":"hljs-punctuation"},"]"]," ",["SPAN",{"class":"hljs-punctuation"},"}"],"\n",["SPAN",{"class":"hljs-punctuation"},"}"],"\n"]],"\n"],["P",{},"路径相对于这份配置的位置解释；配置不在项目根目录时，应相应调整。TypeScript 的 paths 帮助类型解析，不会替你改写运行时的 import。只配它可能编辑器通过但构建失败；只配 Vite 则可能页面可用而编辑器找不到类型。"],"\n",["P",{},"Vite 配置运行在工具环境，可以导入 ",["CODE",{},"node:url"],"；浏览器里的组件不能因此使用全部 Node API。遇到 node 模块类型缺失，还应确认脚手架的 Node 类型与配置检查范围，别把工具配置硬塞进只面向 DOM 的类型环境。"],"\n",["H3",{"id":"环境变量进入客户端以后就是公开配置"},"环境变量进入客户端以后就是公开配置"],"\n",["P",{},"API 的公开地址、显示开关等可以随环境变化。Vite 通过 ",["CODE",{},"import.meta.env"]," 提供这些信息，自定义变量默认需要 ",["CODE",{},"VITE_"]," 前缀才暴露给客户端；前缀也可以由项目配置调整。"],"\n",["P",{},"继续使用建立工程时的根目录 ",["CODE",{},".env"],"，其中 ",["CODE",{},"VITE_API_BASE=/api"],"、",["CODE",{},"VITE_SHOW_READING_TIPS=false"],"；此处不新增环境文件。"],"\n",["P",{},"创建一个可在组件中导入的 ",["CODE",{},"src/public-config.ts"],"："],"\n",["DIV",{"class":"code-block","data-language":"ts"},["DIV",{"class":"code-block__bar"},["SPAN",{},"ts"],["BUTTON",{"type":"button","class":"code-copy"},"复制代码"]],["PRE",{"class":"hljs"},["CODE",{},["SPAN",{"class":"hljs-keyword"},"const"]," apiBase = ",["SPAN",{"class":"hljs-keyword"},"import"],".",["SPAN",{"class":"hljs-property"},"meta"],".",["SPAN",{"class":"hljs-property"},"env"],".",["SPAN",{"class":"hljs-property"},"VITE_API_BASE"],"?.",["SPAN",{"class":"hljs-title function_"},"trim"],"();\n",["SPAN",{"class":"hljs-keyword"},"if"]," (!apiBase) ",["SPAN",{"class":"hljs-keyword"},"throw"]," ",["SPAN",{"class":"hljs-keyword"},"new"]," ",["SPAN",{"class":"hljs-title class_"},"Error"],"(",["SPAN",{"class":"hljs-string"},"'缺少公开 API 地址 VITE_API_BASE'"],");\n\n",["SPAN",{"class":"hljs-keyword"},"const"]," tipsFlag = ",["SPAN",{"class":"hljs-keyword"},"import"],".",["SPAN",{"class":"hljs-property"},"meta"],".",["SPAN",{"class":"hljs-property"},"env"],".",["SPAN",{"class":"hljs-property"},"VITE_SHOW_READING_TIPS"],";\n",["SPAN",{"class":"hljs-keyword"},"if"]," (tipsFlag !== ",["SPAN",{"class":"hljs-literal"},"undefined"]," && tipsFlag !== ",["SPAN",{"class":"hljs-string"},"'true'"]," && tipsFlag !== ",["SPAN",{"class":"hljs-string"},"'false'"],") {\n  ",["SPAN",{"class":"hljs-keyword"},"throw"]," ",["SPAN",{"class":"hljs-keyword"},"new"]," ",["SPAN",{"class":"hljs-title class_"},"Error"],"(",["SPAN",{"class":"hljs-string"},"'VITE_SHOW_READING_TIPS 应为 true 或 false'"],");\n}\n",["SPAN",{"class":"hljs-keyword"},"export"]," ",["SPAN",{"class":"hljs-keyword"},"const"]," publicConfig = {\n  apiBase,\n  ",["SPAN",{"class":"hljs-attr"},"showReadingTips"],": tipsFlag === ",["SPAN",{"class":"hljs-string"},"'true'"],",\n};\n"]],"\n"],["P",{},"自定义环境变量读到的是字符串。因此 ",["CODE",{},"Boolean('false')"]," 仍是 true，不能用它解释关闭开关。内置 ",["CODE",{},"DEV"],"、",["CODE",{},"PROD"],"、",["CODE",{},"SSR"]," 等变量有各自类型，不要把“所有 env 都是字符串”当成通用规则。"],"\n",["P",{},"更改 ",["CODE",{},".env"]," 后停止并重新启动开发服务。生产值一般在构建时替换进产物，部署后仅修改服务器同名环境变量，不会自动改写已经生成的静态文件。如果产品需要部署时动态配置，就要另外设计明确的加载入口。"],"\n",["P",{},"VITE 前缀表示“允许进入客户端”，并不表示加密。数据库密码和服务端密钥不应出现在这些配置中；能在浏览器脚本或请求中读取的地址和开关，应按公开信息对待。"],"\n",["P",{},"选读：模式文件可覆盖通用文件。若在另一个独立实验目录创建 ",["CODE",{},".env.development"]," 并设置 ",["CODE",{},"VITE_API_BASE=/dev-api"],"，默认开发模式会优先使用它；默认生产构建仍使用 ",["CODE",{},".env"]," 中的 ",["CODE",{},"/api"],"。此时只删 ",["CODE",{},".env"]," 的地址不会让开发模式报缺失错误。本篇必做工程不加入这个文件；如果之前已加入，应先移除额外环境文件并重启，再做下方单变量故障。已有进程环境中的同名变量优先级更高。规则见 ",["A",{"href":"https://cn.vite.dev/guide/env-and-mode#env-files","target":"_blank","rel":"noopener noreferrer"},"Vite 环境文件说明"],"（2026-11-10 核验，在线文档未标补丁版本；本篇实测 Vite 6.4.4）。"],"\n",["P",{},"mode 与生产优化也别混在一起：",["CODE",{},"vite build --mode staging"]," 可以读取 staging 配置，但 build 仍是在做生产构建。命令、mode、环境文件与最终值需要一起看，不能只凭文件名判断行为。"],"\n",["H3",{"id":"图片进入依赖图还是保持固定名字"},"图片进入依赖图还是保持固定名字"],"\n",["P",{},"资源有两条常见路径。需要与源码一起追踪的图片放在 src 中，通过导入得到 URL；必须保留固定名称的文件可以放在 public。"],"\n",["P",{},"例如新建 ",["CODE",{},"src/assets/book.svg"],"："],"\n",["DIV",{"class":"code-block","data-language":"svg"},["DIV",{"class":"code-block__bar"},["SPAN",{},"svg"],["BUTTON",{"type":"button","class":"code-copy"},"复制代码"]],["PRE",{"class":"hljs"},["CODE",{},["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"svg"]," ",["SPAN",{"class":"hljs-attr"},"xmlns"],"=",["SPAN",{"class":"hljs-string"},"\"http://www.w3.org/2000/svg\""]," ",["SPAN",{"class":"hljs-attr"},"viewBox"],"=",["SPAN",{"class":"hljs-string"},"\"0 0 32 32\""],">"],"\n  ",["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"rect"]," ",["SPAN",{"class":"hljs-attr"},"x"],"=",["SPAN",{"class":"hljs-string"},"\"6\""]," ",["SPAN",{"class":"hljs-attr"},"y"],"=",["SPAN",{"class":"hljs-string"},"\"4\""]," ",["SPAN",{"class":"hljs-attr"},"width"],"=",["SPAN",{"class":"hljs-string"},"\"20\""]," ",["SPAN",{"class":"hljs-attr"},"height"],"=",["SPAN",{"class":"hljs-string"},"\"24\""]," ",["SPAN",{"class":"hljs-attr"},"rx"],"=",["SPAN",{"class":"hljs-string"},"\"3\""]," ",["SPAN",{"class":"hljs-attr"},"fill"],"=",["SPAN",{"class":"hljs-string"},"\"#38745a\""],"/>"],"\n  ",["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"path"]," ",["SPAN",{"class":"hljs-attr"},"d"],"=",["SPAN",{"class":"hljs-string"},"\"M11 10h10M11 15h10M11 20h7\""]," ",["SPAN",{"class":"hljs-attr"},"stroke"],"=",["SPAN",{"class":"hljs-string"},"\"white\""]," ",["SPAN",{"class":"hljs-attr"},"stroke-width"],"=",["SPAN",{"class":"hljs-string"},"\"2\""],"/>"],"\n",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"svg"],">"],"\n"]],"\n"],["P",{},"然后在独立的 ",["CODE",{},"App.vue"]," 中使用："],"\n",["DIV",{"class":"code-block","data-language":"vue"},["DIV",{"class":"code-block__bar"},["SPAN",{},"vue"],["BUTTON",{"type":"button","class":"code-copy"},"复制代码"]],["PRE",{"class":"hljs"},["CODE",{},"<script setup lang=\"ts\">\nimport bookUrl from './assets/book.svg';\n</script>\n<template>\n  <main>\n    <h1><img :src=\"bookUrl\" alt=\"\" width=\"32\" height=\"32\"> 我的阅读室</h1>\n  </main>\n</template>\n"]],"\n"],["P",{},"图标在此处只是装饰，旁边已有标题，因此空 alt 避免重复描述。导入资源进入构建依赖图，构建工具可能生成带 hash 的文件，也可能把足够小的资源内联；不要承诺每次一定出现单独图片文件。"],"\n",["P",{},["CODE",{},"public/robots.txt"]," 的访问路径通常是站点公共根下的 ",["CODE",{},"robots.txt"],"，而不是 ",["CODE",{},"public/robots.txt"],"。部署在子路径时，还要考虑 Vite 的 ",["CODE",{},"base"],"；手写根路径和由工具转换的导入 URL 不是同一回事。静态 URL、动态拼接路径与公共资源各自如何处理，应按实际部署路径核对。"],"\n",["H3",{"id":"开发代理不会装进-dist"},"开发代理不会装进 dist"],"\n",["P",{},"本地前端和后端运行在不同端口时，开发服务器可以代理 ",["CODE",{},"/api"],"。下面是项目根目录的另一份完整配置示例，演示本地后端地址："],"\n",["DIV",{"class":"code-block","data-language":"ts"},["DIV",{"class":"code-block__bar"},["SPAN",{},"ts"],["BUTTON",{"type":"button","class":"code-copy"},"复制代码"]],["PRE",{"class":"hljs"},["CODE",{},["SPAN",{"class":"hljs-keyword"},"import"]," { defineConfig } ",["SPAN",{"class":"hljs-keyword"},"from"]," ",["SPAN",{"class":"hljs-string"},"'vite'"],";\n",["SPAN",{"class":"hljs-keyword"},"import"]," vue ",["SPAN",{"class":"hljs-keyword"},"from"]," ",["SPAN",{"class":"hljs-string"},"'@vitejs/plugin-vue'"],";\n\n",["SPAN",{"class":"hljs-keyword"},"export"]," ",["SPAN",{"class":"hljs-keyword"},"default"]," ",["SPAN",{"class":"hljs-title function_"},"defineConfig"],"({\n  ",["SPAN",{"class":"hljs-attr"},"plugins"],": [",["SPAN",{"class":"hljs-title function_"},"vue"],"()],\n  ",["SPAN",{"class":"hljs-attr"},"server"],": {\n    ",["SPAN",{"class":"hljs-attr"},"proxy"],": {\n      ",["SPAN",{"class":"hljs-string"},"'/api'"],": { ",["SPAN",{"class":"hljs-attr"},"target"],": ",["SPAN",{"class":"hljs-string"},"'http://127.0.0.1:3000'"],", ",["SPAN",{"class":"hljs-attr"},"changeOrigin"],": ",["SPAN",{"class":"hljs-literal"},"true"]," },\n    },\n  },\n});\n"]],"\n"],["P",{},"使用这个例子需要本机后端实际监听对应地址；没有后端时，代理失败是预期现象。浏览器请求开发服务器的 ",["CODE",{},"/api/lessons"],"，Vite 再转给后端。这里没有 rewrite，所以路径中的 ",["CODE",{},"/api"]," 会保留。"],"\n",["P",{},"构建后，dist 是静态产物，不含开发代理进程。正式服务若仍使用 ",["CODE",{},"/api"],"，就需要部署服务器配置对应转发，或者采用明确的公开 API 地址。不要因为本地代理正常，就把线上 404 归因于 Vue 的响应式或组件代码。"],"\n",["P",{},"代理和 CORS 处理的是访问路径与浏览器跨源读取规则；服务端身份和权限判断仍要存在。这个例子的意义是看清请求经过谁，不要求在入门阶段搭建完整生产网络。"],"\n",["H3",{"id":"hmr-保留开发状态但不承担持久化"},"HMR 保留开发状态但不承担持久化"],"\n",["P",{},"保存组件文件后，页面往往立即变化，这叫",["STRONG",{},"热模块替换（hot module replacement",["BUTTON",{"type":"button","class":"pronunciation-button","data-pronunciation-term":"hot module replacement","data-pronunciation-src":"/pronunciation/b04/721bae641373633e.wav","aria-label":"播放“hot module replacement”的美式发音","title":"播放“hot module replacement”的美式发音"},["SPAN",{"aria-hidden":"true"},"🔊"]],"）"],"，简称 ",["STRONG",{},"HMR"],["BUTTON",{"type":"button","class":"pronunciation-button","data-pronunciation-term":"HMR","data-pronunciation-src":"/pronunciation/b04/6b7e1b1d338a5d36.wav","aria-label":"播放“HMR”的美式发音","title":"播放“HMR”的美式发音"},["SPAN",{"aria-hidden":"true"},"🔊"]],"。Vue 插件会尽量在适合的修改中保留组件状态，减少开发时重复操作。"],"\n",["P",{},"可以展开刚才第一张资料卡片，修改模板中的说明文字，观察是否保留展开状态；再完整刷新，展开状态会按组件初始值重建。不同修改可能触发不同程度的重建，不能把“某次热更新保留了”当作产品保证。"],"\n",["P",{},"如果改代码越多，计时器或监听器越多，要查资源是否有清理，而不是期待刷新永久解决。模块顶层副作用与组件实例生命周期是不同范围；相关原则可以回看 ",["A",{"href":"/knowledge/materials/js-06-es-modules-module-boundaries.md/js-06#%E5%AF%BC%E5%85%A5%E6%97%B6%E5%8F%91%E7%94%9F%E7%9A%84%E5%89%AF%E4%BD%9C%E7%94%A8%E9%9C%80%E8%A6%81%E6%9C%89%E4%BA%BA%E8%B4%9F%E8%B4%A3%E7%BB%93%E6%9D%9F"},"JS-06 的导入副作用",["SPAN",{"class":"material-reading-badge","data-state":"unread"},"未读"]],"。"],"\n",["P",{},"遇到只在热更新后出现的问题，做一次完整刷新作为对照很有帮助。源码冷启动也能复现时，再沿入口和状态路径继续查；不要一开始就同时删缓存、换版本和改业务代码。"],"\n",["H3",{"id":"scoped-css-限制选择器不隔离整个世界"},"Scoped CSS 限制选择器不隔离整个世界"],"\n",["P",{},["CODE",{},"<style scoped>"]," 会让编译器为选择器与相应元素加入作用域标记。概念上，",["CODE",{},".card"]," 会变成匹配带特定属性的 ",["CODE",{},".card[data-v-xxxx]"],"，从而减少组件样式意外命中其他位置。"],"\n",["P",{},"它不是 Shadow DOM，也不是禁止外部 CSS 影响的墙。全局样式可以影响组件，字体与颜色可以继承，CSS 自定义属性也会沿正常规则传递。子组件根节点可同时受到父组件 scoped 样式与自己的 scoped 样式影响，这常用于父层控制布局。"],"\n",["P",{},"需要选择子组件内部元素时可以用 ",["CODE",{},":deep()"],"，但这会增加对内部结构的依赖。先看看组件是否提供合适的 prop、class 或变量入口，再决定是否穿透。Teleport 改变节点的 DOM 位置，也会影响依赖祖先关系的选择器，不要只看组件源码嵌套。"],"\n",["P",{},"把全局排版和颜色变量放在明确入口，组件局部样式跟随组件，跨组件覆盖保持可搜索。遇到规则不生效，查看真实 DOM、生成选择器与层叠顺序，比连续叠加 ",["CODE",{},"!important"]," 更容易得到可维护的结果。"],"\n",["H3",{"id":"固定入口练习与单变量排错"},"固定入口练习与单变量排错"],"\n",["P",{},"在两张卡片版本 App.vue 的 script setup 中加入 ",["CODE",{},"import { publicConfig } from './public-config'"],"，并把卡片导入改为 ",["CODE",{},"import ReadingCard from '@/ReadingCard.vue'"],"。在 main 内加入 ",["CODE",{},"<p>公开地址：{{ publicConfig.apiBase }}；提示开关：{{ publicConfig.showReadingTips }}</p>"],"。此时应显示 /api 与 false，两张卡片初始收起，点击第一张只展开第一张。"],"\n",["P",{},"为检查样式边界，在 ReadingCard.vue 末尾加入 ",["CODE",{},"<style scoped>h2 { color: rgb(20, 100, 60); }</style>"],"，在 App.vue 的 main 内另加 ",["CODE",{},"<h2>卡片外标题</h2>"],"。CSS 选择器 h2 选择标题元素，color 设置文本颜色；scoped 后只有卡片内部标题被这条规则命中。DevTools 中检查实际 h2 与作用域属性，不能用“所有外部样式都进不来”解释。字体继承与全局规则仍可能影响组件。"],"\n",["P",{},"每次只注入一种故障，记录原配置、错误输出、最小修复和恢复结果："],"\n",["TABLE",{},"\n",["THEAD",{},"\n",["TR",{},"\n",["TH",{},"固定故障"],"\n",["TH",{},"可观察结果及证伪动作"],"\n",["TH",{},"最小修复"],"\n"],"\n"],"\n",["TBODY",{},"\n",["TR",{},"\n",["TD",{},"只删除 Vite resolve.alias，保留 TS paths"],"\n",["TD",{},"typecheck 通过而 build 无法解析 @/ReadingCard.vue；相对路径能构建，证伪组件语法错误"],"\n",["TD",{},"恢复 Vite 别名"],"\n"],"\n",["TR",{},"\n",["TD",{},"从唯一的 .env 删除 VITE_API_BASE，停止并重启 dev；另运行 build 后启动 preview"],"\n",["TD",{},"开发页与生产预览页均抛出“缺少公开 API 地址 VITE_API_BASE”，卡片未挂载；build 本身仍成功，HTML 与模块请求成功但模块求值抛错，证伪 mount ID 错误"],"\n",["TD",{},"恢复公开变量，再重启 dev、重新 build 并预览，两处均恢复 /api 与 false；绝不填写密钥"],"\n"],"\n",["TR",{},"\n",["TD",{},"删除卡片 style 的 scoped"],"\n",["TD",{},"卡片外 h2 也被命中，DevTools 中规则没有作用域限制"],"\n",["TD",{},"恢复 scoped；不靠叠加 !important"],"\n"],"\n",["TR",{},"\n",["TD",{},"将 main.ts 的 mount 改成 #missing"],"\n",["TD",{},"容器不存在，页面空白；HTML 中 #app 存在，证伪 SFC 没有导出"],"\n",["TD",{},"改回 #app"],"\n"],"\n"],"\n"],"\n",["P",{},"复测只将第二张卡片 minutes 从 30 改成 45：typecheck/build 应通过，展开第二张后文字变为 45，第一张仍为 25，入口、别名与公开配置不变。原先路由地址、路由懒加载和 chunk 检查留给 VUE-07 的后续练习，不是本入口必考。跨框架对照仅供已经了解 React 的读者选读。"],"\n",["H3",{"id":"类型检查和构建各自回答不同问题"},"类型检查和构建各自回答不同问题"],"\n",["P",{},"故意把卡片的 ",["CODE",{},":minutes=\"25\""]," 改成 ",["CODE",{},"minutes=\"很多\""],"：模板可以被转成 JavaScript，但这不代表 props 类型正确。Vue 项目常用 ",["CODE",{},"vue-tsc"]," 检查 SFC 与模板关系，而 Vite 的 TypeScript 转换本身不等于完整类型检查。"],"\n",["P",{},"本篇练习的必要核对可以很集中：确认脚本包含类型检查；生成一次生产产物；本地预览标题、卡片和资源。若使用路由，再检查直接访问页面地址与刷新时服务器是否正确返回入口。无须为认识一个 SFC 就先建立庞大的测试体系。"],"\n",["P",{},"锁文件保存实际依赖解析结果，便于另一台机器重现同一套工具。团队应约定 Node 与包管理器范围；升级时读对应版本说明，再看实际锁文件和产物变化。仅修改版本范围并不能证明所有人已使用同一依赖版本。"],"\n",["P",{},"当页面空白时，可以按入口顺序逐项说明证据：HTML 是否成功返回，模块请求是否成功，挂载容器是否存在，组件是否编译，运行时是否抛错，资源路径是否正确。这样定位到哪一层，就只修改相关问题，避免让简单错误被更多无关调整掩盖。"],"\n",["P",{},"类型写法就地理解：",["CODE",{},"{ title: string; minutes: number }"]," 约定两个字段；",["CODE",{},"useState<0 | 1>"]," 限定只能保存 0 或 1；",["CODE",{},"defineProps<{ ... }>()"]," 声明组件输入类型。使用这些声明不要求先完成 TS-03 的泛型设计、keyof 与索引访问。TS-01 可作为类型记号的推荐补读，TS-03 属于深入学习。"],"\n",["H3",{"id":"参考与延伸阅读"},"参考与延伸阅读"],"\n",["UL",{},"\n",["LI",{},["A",{"href":"https://cn.vuejs.org/guide/quick-start.html","target":"_blank","rel":"noopener noreferrer"},"Vue：快速上手"],"：查当前脚手架、环境要求与创建步骤。"],"\n",["LI",{},["A",{"href":"https://cn.vuejs.org/api/sfc-script-setup.html","target":"_blank","rel":"noopener noreferrer"},"Vue：script setup"],"：查实例执行、编译器宏和顶层绑定。"],"\n",["LI",{},["A",{"href":"https://cn.vuejs.org/api/sfc-css-features.html","target":"_blank","rel":"noopener noreferrer"},"Vue：SFC CSS 功能"],"：查 scoped、deep、插槽与全局选择器。"],"\n",["LI",{},["A",{"href":"https://cn.vite.dev/guide/","target":"_blank","rel":"noopener noreferrer"},"Vite：开始"],"：查开发与构建入口，并切换到所用版本的文档。"],"\n",["LI",{},["A",{"href":"https://cn.vite.dev/guide/env-and-mode","target":"_blank","rel":"noopener noreferrer"},"Vite：环境变量和模式"],"：查变量前缀、类型、替换与 mode。"],"\n",["LI",{},["A",{"href":"https://cn.vite.dev/guide/assets","target":"_blank","rel":"noopener noreferrer"},"Vite：静态资源处理"],"：查导入资源、public 与部署路径。"],"\n"],"\n"]],["NAV",{"data-v-765dde2a":"","class":"chapter-pagination","aria-label":"继续学习"},["A",{"data-v-765dde2a":"","href":"/knowledge/materials/react-01-render-purity-state-snapshot.md/react-01","class":""},["SMALL",{"data-v-765dde2a":""},"← 同组上一篇"],["STRONG",{"data-v-765dde2a":""},"React 渲染与快照"]],["A",{"data-v-765dde2a":"","href":"/knowledge/materials/vue-02-ref-reactive-computed-boundaries.md/vue-02","class":""},["SMALL",{"data-v-765dde2a":""},"同组下一篇 →"],["STRONG",{"data-v-765dde2a":""},"Vue 响应式与派生值"]]],["FOOTER",{"data-v-765dde2a":""},["SPAN",{"data-v-765dde2a":""},"正文阅读超过 80% 仅标记资料看完，不改变知识点状态"],["BUTTON",{"data-v-765dde2a":"","type":"button"},"返回上一页 →"]],["SPAN",{"data-v-765dde2a":"","class":"pronunciation-feedback","aria-live":"polite"}],["SPAN",{"data-v-765dde2a":"","class":"reading-save-feedback","aria-live":"polite"}]],["ASIDE",{"data-v-765dde2a":"","class":"support-rail"},["SECTION",{"data-v-765dde2a":"","class":"concept-connections"},["SMALL",{"data-v-765dde2a":""},"知识连接"],["P",{"data-v-765dde2a":""},"遇到疑惑时，跳到相关小节。返回后继续刚才的阅读。"],"",["A",{"data-v-765dde2a":"","href":"/knowledge/materials/js-06-es-modules-module-boundaries.md/js-06#%E6%A8%A1%E5%9D%97%E5%9B%BE%E4%B8%8D%E6%98%AF%E6%8A%8A%E4%BB%A3%E7%A0%81%E6%8C%89%E6%96%87%E5%AD%97%E9%A1%BA%E5%BA%8F%E7%B2%98%E8%B5%B7%E6%9D%A5","class":""},["SMALL",{"data-v-765dde2a":""},"JS-06"],["STRONG",{"data-v-765dde2a":""},"模块图不是把代码按文字顺序粘起来 ↗"],["SPAN",{"data-v-765dde2a":""},"入口文件导入组件，仍遵守 ES Modules 的解析与求值规则。"]],["A",{"data-v-765dde2a":"","href":"/knowledge/materials/