7%AB%8B%E5%85%AC%E5%BC%80%E5%85%A5%E5%8F%A3"},"JS-06 模块边界",["SPAN",{"class":"material-reading-badge","data-state":"unread"},"未读"]],"。本篇只用静态导入，不要求先掌握动态导入、Promise 错误与资源清理整条链。"],"\n",["LI",{},"直接前置：",["A",{"href":"/knowledge/materials/web-01-html-semantics-forms-accessibility.md/web-01"},"WEB-01",["SPAN",{"class":"material-reading-badge","data-state":"unread"},"未读"]],"。HTML 元素、按钮与挂载容器：读懂组件输出。"],"\n"],"\n",["P",{},"本文采用 Vue 3 的组合式 API 与 ",["CODE",{},"<script setup lang=\"ts\">"],"。例子沿用常见的 Vite 项目结构；脚手架的选项、Node.js 要求与默认配置会随版本变化，创建新项目时以对应版本的官方说明为准。读懂角色比背下一份特定版本的生成清单更有用。"],"\n",["P",{},"本篇先就地读懂模块记号：",["CODE",{},"export default"]," 导出一个默认值，",["CODE",{},"import App from './App'"]," 取这个默认值，名称由导入方命名；",["CODE",{},"import { useState } from 'react'"]," 或 ",["CODE",{},"import { ref } from 'vue'"]," 取库中同名导出。相对路径从当前文件所在目录解析，裸包名由工程工具从依赖解析。导入的组件交给框架创建实例，不是复制粘贴模块源码。每个模块实例通常只求值一次，组件函数或 setup 则可按实例执行多次。后文沿这些规则追踪入口，不使用动态 import。"],"\n",["H3",{"id":"建立可复现的练习工程"},"建立可复现的练习工程"],"\n",["P",{},"新建一个独立空目录（例如 ",["CODE",{},"framework-entry-lab"],"），不要覆盖已有项目。使用 Node 22.14.0，按以下路径创建文件，再运行 ",["CODE",{},"npm install"],"、",["CODE",{},"npm run typecheck"],"、",["CODE",{},"npm run build"],"、",["CODE",{},"npm run dev -- --host 127.0.0.1"],"。安装后保留生成的 package-lock.json，复现时用 ",["CODE",{},"npm ci"],"。组件源码和浏览器结果作为练习提交正文；站内 JavaScript/TypeScript 自检不提供 React/Vue DOM 运行环境，不能把 TSX/SFC 直接当普通脚本执行。站内断言只能补充核对已取得的结果，不能替代工程类型、构建与浏览器证据。这些是本篇固定版本，不代表最新版本或升级建议。"],"\n",["P",{},["CODE",{},"package.json"],"："],"\n",["DIV",{"class":"code-block","data-language":"json"},["DIV",{"class":"code-block__bar"},["SPAN",{},"json"],["BUTTON",{"type":"button","class":"code-copy"},"复制代码"]],["PRE",{"class":"hljs"},["CODE",{},["SPAN",{"class":"hljs-punctuation"},"{"],"\n  ",["SPAN",{"class":"hljs-attr"},"\"private\""],["SPAN",{"class":"hljs-punctuation"},":"]," ",["SPAN",{"class":"hljs-literal"},["SPAN",{"class":"hljs-keyword"},"true"]],["SPAN",{"class":"hljs-punctuation"},","],"\n  ",["SPAN",{"class":"hljs-attr"},"\"type\""],["SPAN",{"class"