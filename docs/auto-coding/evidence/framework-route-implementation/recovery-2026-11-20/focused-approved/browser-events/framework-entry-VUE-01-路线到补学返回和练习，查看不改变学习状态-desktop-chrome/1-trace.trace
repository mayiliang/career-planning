PAN",{"class":"hljs-name"},"button"],">"],"\n  ",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"form"],">"],"\n",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"dialog"],">"],"\n",["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"script"],">"],["SPAN",{"class":"language-javascript"},"\n  ",["SPAN",{"class":"hljs-keyword"},"const"]," opener = ",["SPAN",{"class":"hljs-variable language_"},"document"],".",["SPAN",{"class":"hljs-title function_"},"querySelector"],"(",["SPAN",{"class":"hljs-string"},"'#open-settings'"],");\n  ",["SPAN",{"class":"hljs-keyword"},"const"]," dialog = ",["SPAN",{"class":"hljs-variable language_"},"document"],".",["SPAN",{"class":"hljs-title function_"},"querySelector"],"(",["SPAN",{"class":"hljs-string"},"'#settings'"],");\n  ",["SPAN",{"class":"hljs-keyword"},"const"]," checkbox = ",["SPAN",{"class":"hljs-variable language_"},"document"],".",["SPAN",{"class":"hljs-title function_"},"querySelector"],"(",["SPAN",{"class":"hljs-string"},"'#dense'"],");\n  ",["SPAN",{"class":"hljs-keyword"},"const"]," status = ",["SPAN",{"class":"hljs-variable language_"},"document"],".",["SPAN",{"class":"hljs-title function_"},"querySelector"],"(",["SPAN",{"class":"hljs-string"},"'#settings-status'"],");\n  ",["SPAN",{"class":"hljs-keyword"},"let"]," savedDense = ",["SPAN",{"class":"hljs-literal"},"false"],";\n\n  opener.",["SPAN",{"class":"hljs-title function_"},"addEventListener"],"(",["SPAN",{"class":"hljs-string"},"'click'"],", ",["SPAN",{"class":"hljs-function"},"() =>"]," {\n    checkbox.",["SPAN",{"class":"hljs-property"},"checked"]," = savedDense;\n    dialog.",["SPAN",{"class":"hljs-property"},"returnValue"]," = ",["SPAN",{"class":"hljs-string"},"''"],";\n    dialog.",["SPAN",{"class":"hljs-title function_"},"showModal"],"();\n  });\n  dialog.",["SPAN",{"class":"hljs-title function_"},"addEventListener"],"(",["SPAN",{"class":"hljs-string"},"'close'"],", ",["SPAN",{"class":"hljs-function"},"() =>"]," {\n    ",["SPAN",{"class":"hljs-keyword"},"if"]," (dialog.",["SPAN",{"class":"hljs-property"},"returnValue"]," === ",["SPAN",{"class":"hljs-string"},"'save'"],") savedDense = checkbox.",["SPAN",{"class":"hljs-property"},"checked"],";\n    status.",["SPAN",{"class":"hljs-property"},"textContent"]," = savedDense ? ",["SPAN",{"class":"hljs-string"},"'当前为紧凑间距'"]," : ",["SPAN",{"class":"hljs-string"},"'当前为舒适间距'"],";\n    ",["SPAN",{"class":"hljs-keyword"},"if"]," (opener.",["SPAN",{"class":"hljs-property"},"isConnected"],") opener.",["SPAN",{"class":"hljs-title function_"},"focus"],"();\n  });\n"],["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"script"],">"],"\n",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"html"],">"],"\n"]],"\n"],["P",{},"操作顺序是：打开，勾选，取消，再次打开。复选框应该恢复上一次保存的设置；这次勾选并保存，外部状态才改为紧凑间距。再次打开后按 Escape，也应退出并保留已保存值。"],"\n",["P",{},["CODE",{},"showModal()"]," 将对话框放入顶层显示，并使背景内容不能像普通页面一样被交互；",["CODE",{},"show()"]," 或只添加 ",["CODE",{},"open"]," 是非模态显示。它们外观可以很相似，交互约定却不同。",["CODE",{},"method=\"dialog\""]," 的表单用于关闭对话框并设置返回值，不会像普通表单那样发送网络请求。"],"\n",["P",{},"这里有两个细节：打开时复制已保存设置，形成可以取消的草稿；每次打开先清空 ",["CODE",{},"returnValue"],"，避免上一次“保存”的返回值被后来的 Escape 关闭误用。对话框负责显示与焦点，应用负责“取消是否丢弃修改”的业务含义。"],"\n",["P",{},"示例通过 ",["CODE",{},"autofocus"]," 选择第一个操作位置，通过名称关系说明弹窗主题。较长说明可以让带 ",["CODE",{},"tabindex=\"-1\""]," 的标题先获得焦点；涉及危险操作时应选择合适的初始位置。关闭后一般回到触发控件，若控件已被移除，应改选仍存在且符合任务顺序的位置。"],"\n",["H3",{"id":"动态提示要出现也要适度"},"动态提示要出现也要适度"],"\n",["P",{},"前面的 ",["CODE",{},"role=\"status\""]," 适合“结果已经更新”“设置已保存”这类非紧急反馈。先让状态区域存在，再改变其文本，辅助技术才有明确的变化可以通知；具体播报时机仍受浏览器与辅助技术组合影响。"],"\n",["P",{},"提示应说清结果，不只显示一个绿色图标。提交失败时告诉用户哪里错、怎么改；等待时说明正在处理；按钮是否禁用也要根据重复操作的后果决定。不能把颜色当成唯一信息来源。"],"\n",["P",{},["CODE",{},"aria-live=\"assertive\""]," 会尝试打断当前播报，应留给需要立即注意的情况。一个字符变化产生多个强制通知，会让本来能填写的表单变得难用。也不要为了播报普通状态就把焦点抢到提示上：用户仍可能正在输入。"],"\n",["P",{},"如果一个按钮展开帮助，按钮上的 ",["CODE",{},"aria-expanded"]," 要随展开状态更新，",["CODE",{},"aria-controls"]," 可指向内容区域。简单的说明折叠也可以直接使用 ",["CODE",{},"details"]," 与 ",["CODE",{},"summary"],"，由原生元素处理开关行为。ARIA 表达的是已经实现的状态，不能只加属性而没有实际操作。"],"\n",["H3",{"id":"数据表格先交代行列之间的关系"},"数据表格先交代行列之间的关系"],"\n",["P",{},"只有数据具有行列关系时才使用表格，不要拿表格为整页排版。下面片段可以放进任何 HTML 页面的 ",["CODE",{},"body"],"："],"\n",["DIV",{"class":"code-block","data-language":"html"},["DIV",{"class":"code-block__bar"},["SPAN",{},"html"],["BUTTON",{"type":"button","class":"code-copy"},"复制代码"]],["PRE",{"class":"hljs"},["CODE",{},["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"table"],">"],"\n  ",["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"caption"],">"],"本周学习安排",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"caption"],">"],"\n  ",["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"thead"],">"],"\n    ",["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"tr"],">"],["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"th"]," ",["SPAN",{"class":"hljs-attr"},"scope"],"=",["SPAN",{"class":"hljs-string"},"\"col\""],">"],"资料",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"th"],">"],["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"th"]," ",["SPAN",{"class":"hljs-attr"},"scope"],"=",["SPAN",{"class":"hljs-string"},"\"col\""],">"],"预计用时",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"th"],">"],["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"th"]," ",["SPAN",{"class":"hljs-attr"},"scope"],"=",["SPAN",{"class":"hljs-string"},"\"col\""],">"],"状态",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"th"],">"],["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"tr"],">"],"\n  ",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"thead"],">"],"\n  ",["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"tbody"],">"],"\n    ",["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"tr"],">"],["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"th"]," ",["SPAN",{"class":"hljs-attr"},"scope"],"=",["SPAN",{"class":"hljs-string"},"\"row\""],">"],"HTML 表单",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"th"],">"],["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"td"],">"],"25 分钟",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"td"],">"],["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"td"],">"],"学习中",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"td"],">"],["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"tr"],">"],"\n    ",["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"tr"],">"],["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"th"]," ",["SPAN",{"class":"hljs-attr"},"scope"],"=",["SPAN",{"class":"hljs-string"},"\"row\""],">"],"React 快照",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"th"],">"],["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"td"],">"],"30 分钟",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"td"],">"],["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"td"],">"],"未开始",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"td"],">"],["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"tr"],">"],"\n  ",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"tbody"],">"],"\n",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"table"],">"],"\n"]],"\n"],["P",{},["CODE",{},"caption"]," 说明表格主题；列头说明这列是什么，行头说明当前行属于哪份资料。复杂跨行跨列表头需要更明确的关联，但普通表格不必一开始就手写全部 ARIA 角色。"],"\n",["P",{},"如果以后使用 ",["A",{"href":"/knowledge/materials/ts-03-generics-constraints-keyof-indexed-access.md/ts-03#%E5%9C%A8%E5%88%9B%E5%BB%BA%E5%88%97%E6%97%B6%E4%BF%9D%E5%AD%98%E5%85%B3%E7%B3%BB%E8%AE%A9%E6%B8%B2%E6%9F%93%E4%BF%9D%E6%8C%81%E7%AE%80%E5%8D%95"},"TS-03 的类型化列配置",["SPAN",{"class":"material-reading-badge","data-state":"unread"},"未读"]],"生成表格，类型解决的是列与值匹配，HTML 解决的是最终页面如何被理解。这两层可以互相配合，不能互相替代。"],"\n",["H3",{"id":"框架最终仍要生成可用的-html"},"框架最终仍要生成可用的 HTML"],"\n",["P",{},"React 的 JSX、Vue 的模板都只是另一种描述页面的方式。按钮仍要有名称，表单仍需要标签，弹窗仍要管理进出焦点。学习 ",["A",{"href":"/knowledge/materials/react-01-render-purity-state-snapshot.md/react-01#%E4%B8%80%E6%AC%A1%E6%9B%B4%E6%96%B0%E5%88%86%E6%88%90%E8%A7%A6%E5%8F%91%E8%AE%A1%E7%AE%97%E5%92%8C%E6%8F%90%E4%BA%A4"},"React 的渲染与提交",["SPAN",{"class":"material-reading-badge","data-state":"completed"},"已看完"]],"时，可以把提交理解为框架把这份描述落实到 DOM。"],"\n",["P",{},"普通文本插入应使用框架的文本绑定或 DOM 的 ",["CODE",{},"textContent"],"。把不可信字符串交给 ",["CODE",{},"innerHTML"],"、",["CODE",{},"v-html"]," 或 ",["CODE",{},"dangerouslySetInnerHTML"],"，浏览器会把它当标记解释，可能引入不应执行的内容。确需富文本时，要在清楚的输入边界做适当净化；仅删除 script 标签并不充分。"],"\n",["P",{},"语义、交互和安全是不同问题。用上原生 dialog 不会自动验证删除权限，过滤过的 HTML 也不保证标题层级正确。把职责说清楚，才能在框架组件中复用一套可理解的行为。"],"\n",["H3",{"id":"用一条完整操作路径检查理解"},"用一条完整操作路径检查理解"],"\n",["P",{},"挑一个例子，只用键盘走完进入、填写、提交、修正和退出。每一步都回答：现在焦点在哪，控件叫什么，操作产生了什么结果，失败后能否继续？再查看浏览器的可访问性面板，核对名称和描述是否真与预期相同。"],"\n",["P",{},"页面外观、DOM 结构和可访问性树提供不同证据。自动扫描可以发现部分缺失，不能替你判断“取消后用户会不会误以为保存了”。对实际产品，还应针对目标浏览器与辅助技术做必要人工体验；不需要把一篇入门资料读成一套庞大的测试流程。"],"\n",["P",{},"当你能解释 ",["CODE",{},"id"]," 与 ",["CODE",{},"name"]," 的区别、为什么按钮不该伪装成 div、错误怎样连到字段，以及 Escape 后草稿和焦点分别去了哪里，HTML 就已经从标签清单变成了可推理的交互基础。"],"\n",["H3",{"id":"参考与延伸阅读"},"参考与延伸阅读"],"\n",["UL",{},"\n",["LI",{},["A",{"href":"https://developer.mozilla.org/en-US/docs/Learn_web_development/Extensions/Forms/Your_first_form","target":"_blank","rel":"noopener noreferrer"},"MDN：Your first form"],"：补充表单结构、标签和提交方式。"],"\n",["LI",{},["A",{"href":"https://developer.mozilla.org/en-US/docs/Web/API/FormData/FormData","target":"_blank","rel":"noopener noreferrer"},"MDN：FormData 构造函数"],"：查字段收集与 submitter 参数。"],"\n",["LI",{},["A",{"href":"https://developer.mozilla.org/en-US/docs/Learn_web_development/Extensions/Forms/Form_validation","target":"_blank","rel":"noopener noreferrer"},"MDN：客户端表单校验"],"：查约束、validity 和自定义反馈。"],"\n",["LI",{},["A",{"href":"https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Elements/dialog","target":"_blank","rel":"noopener noreferrer"},"MDN：dialog 元素"],"：查模态、关闭、焦点及兼容性。"],"\n",["LI",{},["A",{"href":"https://developer.mozilla.org/en-US/docs/Web/Accessibility/ARIA","target":"_blank","rel":"noopener noreferrer"},"MDN：ARIA"],"：需要补充角色或状态时查询，优先确认已有原生元素是否适用。"],"\n"],"\n"]],["NAV",{"data-v-765dde2a":"","class":"chapter-pagination","aria-label":"继续学习"},["A",{"data-v-765dde2a":"","href":"/knowledge/materials/ts-03-generics-constraints-keyof-indexed-access.md/ts-03","class":""},["SMALL",{"data-v-765dde2a":""},"← 同组上一篇"],["STRONG",{"data-v-765dde2a":""},"泛型与键值关系"]],["A",{"data-v-765dde2a":"","href":"/knowledge/materials/react-01-render-purity-state-snapshot.md/react-01","class":""},["SMALL",{"data-v-765dde2a":""},"同组下一篇 →"],["STRONG",{"data-v-765dde2a":""},"React 渲染与快照"]]],["FOOTER",{"data-v-765dde2a":""},["SPAN",{"data-v-765dde2a":""},"正文阅读超过 80% 仅标记资料看完，不改变知识点状态"],["BUTTON",{"data-v-765dde2a":"","type":"button"},"返回上一页 →"]],["SPAN",{"data-v-765dde2a":"","class":"pronunciation-feedback","aria-live":"polite"}],["SPAN",{"data-v-765dde2a":"","class":"reading-save-feedback","aria-live":"polite"}]],["ASIDE",{"data-v-765dde2a":"","class":"support-rail"},["SECTION",{"data-v-765dde2a":"","class":"concept-connections"},["SMALL",{"data-v-765dde2a":""},"知识连接"],["P",{"data-v-765dde2a":""},"遇到疑惑时，跳到相关小节。返回后继续刚才的阅读。"],"",["A",{"data-v-765dde2a":"","href":"/knowledge/materials/ts-03-generics-constraints-keyof-indexed-access.md/ts-03#%E5%9C%A8%E5%88%9B%E5%BB%BA%E5%88%97%E6%97%B6%E4%BF%9D%E5%AD%98%E5%85%B3%E7%B3%BB%E8%AE%A9%E6%B8%B2%E6%9F%93%E4%BF%9D%E6%8C%81%E7%AE%80%E5%8D%95","class":""},["SMALL",{"data-v-765dde2a":""},"TS-03"],["STRONG",{"data-v-765dde2a":""},"在创建列时保存关系让渲染保持简单 ↗"],["SPAN",{"data-v-765dde2a":""},"使用类型化配置生成表格时，继续保留清楚的行列语义。"]],["A",{"data-v-765dde2a":"","href":"/knowledge/materials/react-01-render-purity-state-snapshot.md/react-01#%E4%B8%80%E6%AC%A1%E6%9B%B4%E6%96%B0%E5%88%86%E6%88%90%E8%A7%A6%E5%8F%91%E8%AE%A1%E7%AE%97%E5%92%8C%E6%8F%90%E4%BA%A4","class":""},["SMALL",{"data-v-765dde2a":""},"REACT-01"],["STRONG",{"data-