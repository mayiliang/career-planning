,"选中状态、键盘切换、表单取值"],"\n"],"\n"],"\n"],"\n",["P",{},"给 ",["CODE",{},"div"]," 加点击监听器，只是让鼠标点击时执行函数。它没有因此获得按钮的角色、默认焦点或 Space 行为。即使再补 ",["CODE",{},"role=\"button\""],"，这些交互仍要自己实现。"],"\n",["P",{},"这就是优先使用原生元素的实际收益：同一份标记已经包含一组相互配合的默认行为。 ",["STRONG",{},"ARIA"],["BUTTON",{"type":"button","class":"pronunciation-button","data-pronunciation-term":"ARIA","data-pronunciation-src":"/pronunciation/b04/48803cad0f3dcf64.wav","aria-label":"播放“ARIA”的美式发音","title":"播放“ARIA”的美式发音"},["SPAN",{"aria-hidden":"true"},"🔊"]]," 可以补充名称、状态和关系，但不能替代浏览器的事件逻辑。比如 ",["CODE",{},"aria-disabled=\"true\""]," 只是传达状态；普通元素的点击代码不会因此自动停止。原生 ",["CODE",{},"disabled"]," 则确实参与控件行为。"],"\n",["H3",{"id":"用一个完整表单看清标签与提交"},"用一个完整表单看清标签与提交"],"\n",["P",{},"将下面代码保存为 ",["CODE",{},"search.html"],"。先点击“关键词”文字，再在输入框中键入“闭包”，按 Enter；最后点击“清空”。"],"\n",["DIV",{"class":"code-block","data-language":"html"},["DIV",{"class":"code-block__bar"},["SPAN",{},"html"],["BUTTON",{"type":"button","class":"code-copy"},"复制代码"]],["PRE",{"class":"hljs"},["CODE",{},["SPAN",{"class":"hljs-meta"},"<!doctype ",["SPAN",{"class":"hljs-keyword"},"html"],">"],"\n",["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"html"]," ",["SPAN",{"class":"hljs-attr"},"lang"],"=",["SPAN",{"class":"hljs-string"},"\"zh-CN\""],">"],"\n",["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"meta"]," ",["SPAN",{"class":"hljs-attr"},"charset"],"=",["SPAN",{"class":"hljs-string"},"\"utf-8\""],">"],"\n",["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"title"],">"],"检索表单示例",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"title"],">"],"\n",["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"form"]," ",["SPAN",{"class":"hljs-attr"},"id"],"=",["SPAN",{"class":"hljs-string"},"\"search-form\""],">"],"\n  ",["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"label"]," ",["SPAN",{"class":"hljs-attr"},"for"],"=",["SPAN",{"class":"hljs-string"},"\"query\""],">"],"关键词",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{