一致');\n} catch (error) {\n  console.error({ fixedInput, expected, error: String(error) });\n  throw error;\n}\n","data-v-37950b3f":"","spellcheck":"false","aria-label":"练习代码"}],["DIV",{"data-v-37950b3f":"","class":"execution-output","data-status":"NOT_RUN"},["SPAN",{"data-v-37950b3f":""},"执行结果 · NOT_RUN"],["PRE",{"data-v-37950b3f":""},"尚未执行。请让脚本打印固定输入、预期输出和实际输出。"]]],["LABEL",{"data-v-37950b3f":"","class":"submission-editor"},["SPAN",{"data-v-37950b3f":""},"实现说明与验证记录"],["TEXTAREA",{"__playwright_value_":"# 首考题 3：实现说明\n\n# 固定输入\n\n# 预期输出\n\n# 实际输出\n\n# 首考题 4：异常、根因与修复\n\n# 资料机制映射\n\n# 验证证据\n","data-v-37950b3f":"","rows":"16","placeholder":"请按模板逐项填写；系统将据此验证输入、输出、资料依据和边界。"}]],["OL",{"data-v-37950b3f":"","class":"validation-rail","aria-label":"练习验证阶段"},["LI",{"data-v-37950b3f":"","class":"pending"},["B",{"data-v-37950b3f":""},"1"],["DIV",{"data-v-37950b3f":""},["STRONG",{"data-v-37950b3f":""},"本地结构检查"],["SMALL",{"data-v-37950b3f":""},"尚未执行"]]],["LI",{"data-v-37950b3f":"","class":"pending"},["B",{"data-v-37950b3f":""},"2"],["DIV",{"data-v-37950b3f":""},["STRONG",{"data-v-37950b3f":""},"AI 语义复核"],["SMALL",{"data-v-37950b3f":""},"未参与；不能替代为完全通过。"]]],["LI",{"data-v-37950b3f":"","class":"pending"},["B",{"data-v-37950b3f":""},"3"],["DIV",{"data-v-37950b3f":""},["STRONG",{"data-v-37950b3f":""},"完全通过"],["SMALL",{"data-v-37950b3f":""},"须在前两层均通过后才会点亮。"]]]],["FOOTER",{"data-v-37950b3f":"","class":"workspace-actions"},["BUTTON",{"data-v-37950b3f":"","type":"button"},"保存草稿"],["BUTTON",{"data-v-37950b3f":"","type":"button","class":"primary"},"提交并验证"]],""]],[[5,241]]]],[[5,253]],[[5,298]],[[5,299]]],[[5,301]],[[5,302]],[[5,303]],[[5,304]],[[5,305]]]]]],[[52,131]],[[52,132]],[[52,133]],[[52,141]],[[52,142]]]],[[52,145]],[[52,146]],[[52,147]],[[5,312]],[[5,313]],[[5,314]],[[5,315]]]],"viewport":{"width":1440,"height":1000},"timestamp":73823.548,"wallTime":1795108796687,"collectionTime":2.7000000029802322,"resourceOverrides":[],"isMainFrame":true}}
