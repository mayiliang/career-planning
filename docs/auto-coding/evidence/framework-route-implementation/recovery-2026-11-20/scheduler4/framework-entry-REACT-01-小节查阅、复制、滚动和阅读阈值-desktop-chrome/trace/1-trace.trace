],"更新队列",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"h1"],">"],"\n      ",["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"p"],">"],"计数：",["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"output"],">"],"{count}",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"output"],">"],["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"p"],">"],"\n      ",["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"button"]," ",["SPAN",{"class":"hljs-attr"},"type"],"=",["SPAN",{"class":"hljs-string"},"\"button\""]," ",["SPAN",{"class":"hljs-attr"},"onClick"],"=",["SPAN",{"class":"hljs-string"},"{replaceThreeTimes}"],">"],"按当前值加三次",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"button"],">"],"\n      ",["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"button"]," ",["SPAN",{"class":"hljs-attr"},"type"],"=",["SPAN",{"class":"hljs-string"},"\"button\""]," ",["SPAN",{"class":"hljs-attr"},"onClick"],"=",["SPAN",{"class":"hljs-string"},"{incrementThreeTimes}"],">"],"依次加三次",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"button"],">"],"\n      ",["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"button"]," ",["SPAN",{"class":"hljs-attr"},"type"],"=",["SPAN",{"class":"hljs-string"},"\"button\""]," ",["SPAN",{"class":"hljs-attr"},"onClick"],"=",["SPAN",{"class":"hljs-string"},"{()"]," =>"]," setCount(0)}>重置",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"button"],">"],"\n    ",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"main"],">"]],"\n  );\n}\n"]],"\n"],["P",{},"从零开始，第一种结果是 1，控制台输出的当前值还是 0；第二种结果是 3。这里没有丢掉三次点击，因为你只点击了一次，处理器里有三条更新请求。"],"\n",["P",{},"先代入实际数字。第一次渲染给出的 ",["CODE",{},"count"]," 是 0，所以前三行分别相当于“下次换成 1”“下次换成 1”“下次换成 1”。React 并没有收到“依次加一”的函数，只收到了三个相同的替换值。"],"\n",["P",{},"后一种写法传入更新函数。React 处理队列时，把上一步结果交给下一步，因此依次得到 1、2、3。",["CODE",{},"previous"]," 是队列传入的值，不是你手动从某个全局变量读取的“最新 count”。"],"\n",["P",{},["CODE",{},"useState"]," 是一个 Hook，要在组件顶层按稳定顺序调用，不放进条件、循环或事件处理器。初始值 0 用于这份组件状态的初始化，组件以后重新运行并不会每次都把状态重新设为零。"],"\n",["H3",{"id":"快照属于一次渲染而不是整个组件"},"快照属于一次渲染而不是整个组件"],"\n",["P",{},["STRONG",{},"状态快照（state snapshot",["BUTTON",{"type":"button","class":"pronunciation-button","data-pronunciation-term":"state snapshot","data-pronunciation-src":"/pronunciation/b04/11bd0b627bee4e94.wav","aria-label":"播放“state snapshot”的美式发音","title":"播放“state snapshot”的美式发音"},["SPAN",{"aria-hidden":"true"},"🔊"]],"）"]," 可以理解为“这一轮组件拿到的状态值”。setter 不会修改当前函数作用域里的 ",["CODE",{},"count"],"，而是让 React 在后续渲染中提供新的值。"],"\n",["TABLE",{},"\n",["THEAD",{},"\n",["TR",{},"\n",["TH",{},"时刻"],"\n",["TH",{},"当前函数里的 count"],"\n",["TH",{},"发出的请求"],"\n",["TH",{},"接下来会看到什么"],"\n"],"\n"],"\n",["TBODY",{},"\n",["TR",{},"\n",["TD",{},"初次渲染"],"\n",["TD",{},"0"],"\n",["TD",{},"无"],"\n",["TD",{},"按钮绑定这一轮处理器"],"\n"],"\n",["TR",{},"\n",["TD",{},"点击处理器执行"],"\n",["TD",{},"0"],"\n",["TD",{},"替换成 1"],"\n",["TD",{},"处理器内继续读取仍是 0"],"\n"],"\n",["TR",{},"\n",["TD",{},"后续渲染"],"\n",["TD",{},"1"],"\n",["TD",{},"无"],"\n",["TD",{},"新处理器使用这一轮的 1"],"\n"],"\n"],"\n"],"\n",["P",{},"这里与 ",["A",{"href":"/knowledge/materials/js-01-execution-context-scope-closure.md/js-01#%E9%97%AD%E5%8C%85%E4%BF%9D%E5%AD%98%E7%9A%84%E6%98%AF%E5%8F%98%E9%87%8F%E8%BF%98%E6%98%AF%E5%BF%AB%E7%85%A7"},"闭包保存绑定",["SPAN",{"class":"material-reading-badge","data-state":"reading"},"68%"]],"并不矛盾。每次组件调用都有自己的局部绑定；旧处理器仍引用旧调用中的绑定，新调用创建的是另一组绑定。React 没有把 JavaScript 的闭包规则改成另一套。"],"\n",["P",{},"“快照”也不意味着深拷贝或冻结。如果 state 是对象，你直接改它的属性，仍可能破坏旧渲染所引用的数据。React 的状态约定要求你把已有对象当作不可变值，沿变化路径创建新对象；可以回看 ",["A",{"href":"/knowledge/materials/js-03-types-equality-copy-immutability.md/js-03#%E4%B8%8D%E5%8F%AF%E5%8F%98%E6%9B%B4%E6%96%B0%E6%B2%BF%E4%BF%AE%E6%94%B9%E8%B7%AF%E5%BE%84%E5%88%9B%E5%BB%BA%E6%96%B0%E5%AF%B9%E8%B1%A1"},"JS-03 的不可变更新",["SPAN",{"class":"material-reading-badge","data-state":"completed"},"已看完"]],"。"],"\n",["P",{},"因此，“把 setter 加上 await 就能读到新 count”不是解决办法。setter 不返回一个等待状态变更完成的 Promise；即使函数稍后恢复，原有局部绑定也不会因此换成下一次渲染的绑定。"],"\n",["H3",{"id":"替换值与更新函数可以按顺序混合"},"替换值与更新函数可以按顺序混合"],"\n",["P",{},"不要把更新函数背成“更高级写法”。需要固定结果时，替换值很直接；需要接着队列前一步累积时，更新函数更合适。试试这个完整组件："],"\n",["DIV",{"class":"code-block","data-language":"tsx"},["DIV",{"class":"code-block__bar"},["SPAN",{},"tsx"],["BUTTON",{"type":"button","class":"code-copy"},"复制代码"]],["PRE",{"class":"hljs"},["CODE",{},["SPAN",{"class":"hljs-keyword"},"import"]," { useState } ",["SPAN",{"class":"hljs-keyword"},"from"]," ",["SPAN",{"class":"hljs-string"},"'react'"],";\n\n",["SPAN",{"class":"hljs-keyword"},"export"]," ",["SPAN",{"class":"hljs-keyword"},"default"]," ",["SPAN",{"class":"hljs-keyword"},"function"]," ",["SPAN",{"class":"hljs-title function_"},"App"],"(",["SPAN",{"class":"hljs-params"}],") {\n  ",["SPAN",{"class":"hljs-keyword"},"const"]," [count, setCount] = ",["SPAN",{"class":"hljs-title function_"},"useState"],"(",["SPAN",{"class":"hljs-number"},"0"],");\n  ",["SPAN",{"class":"hljs-keyword"},"function"]," ",["SPAN",{"class":"hljs-title function_"},"change"],"(",["SPAN",{"class":"hljs-params"}],") {\n    ",["SPAN",{"class":"hljs-title function_"},"setCount"],"(count + ",["SPAN",{"class":"hljs-number"},"5"],");\n    ",["SPAN",{"class":"hljs-title function_"},"setCount"],"(",["SPAN",{"class":"hljs-function"},["SPAN",{"class":"hljs-params"},"previous"]," =>"]," previous + ",["SPAN",{"class":"hljs-number"},"1"],");\n    ",["SPAN",{"class":"hljs-title function_"},"setCount"],"(",["SPAN",{"class":"hljs-number"},"42"],");\n  }\n  ",["SPAN",{"class":"hljs-keyword"},"return"]," (\n    ",["SPAN",{"class":"language-xml"},["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"main"],">"],"\n      ",["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"h1"],">"],"混合更新",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"h1"],">"],"\n      ",["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"p"],">"],"计数：{count}",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"p"],">"],"\n      ",["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"button"]," ",["SPAN",{"class":"hljs-attr"},"type"],"=",["SPAN",{"class":"hljs-string"},"\"button\""]," ",["SPAN",{"class":"hljs-attr"},"onClick"],"=",["SPAN",{"class":"hljs-string"},"{change}"],">"],"执行三步更新",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"button"],">"],"\n    ",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"main"],">"]],"\n  );\n}\n"]],"\n"],["P",{},"第一次点击时，按队列顺序可以列出："],"\n",["TABLE",{},"\n",["THEAD",{},"\n",["TR",{},"\n",["TH",{},"更新"],"\n",["TH",{},"输入如何使用"],"\n",["TH",{},"结果"],"\n"],"\n"],"\n",["TBODY",{},"\n",["TR",{},"\n",["TD",{},"替换成 ",["CODE",{},"count + 5"]],"\n",["TD",{},"当前快照为 0，提前算出 5"],"\n",["TD",{},"5"],"\n"],"\n",["TR",{},"\n",["TD",{},["CODE",{},"previous => previous + 1"]],"\n",["TD",{},"接收队列前一步的 5"],"\n",["TD",{},"6"],"\n"],"\n",["TR",{},"\n",["TD",{},"替换成 42"],"\n",["TD",{},"不需要前一步结果"],"\n",["TD",{},"42"],"\n"],"\n"],"\n"],"\n",["P",{},"最终显示 42。如果删除最后一行，第一次点击会显示 6。这种逐步代入方法也适用于 reducer 等后续状态模型，比猜 React “合并掉了哪一行”更清楚。"],"\n",["P",{},"更新函数应该只计算新状态。不要在里面发送请求、追加全局日志记录或调用另一个 setter，因为 React 可能为检查纯度而额外调用它。需要响应用户动作的工作，放在事件处理器对应的位置。"],"\n",["H3",{"id":"批处理不会把不同用户操作变成一次事务"},"批处理不会把不同用户操作变成一次事务"],"\n",["P",{},"React 会把适合一起处理的更新合并安排，减少用户看不到价值的中间提交，这叫",["STRONG",{},"批处理（batching",["BUTTON",{"type":"button","class":"pronunciation-button","data-pronunciation-term":"batching","data-pronunciation-src":"/pronunciation/b04/8224dd5d5f8f3db2.wav","aria-label":"播放“batching”的美式发音","title":"播放“batching”的美式发音"},["SPAN",{"aria-hidden":"true"},"🔊"]],"）"],"。在现代根节点应用中，它不只涉及 React 点击处理器，也覆盖许多异步回调中的更新。"],"\n",["P",{},"但两次有意的点击仍是不同事件。你从零开始分别点击三次“按当前值加三次”，通常会看到 1、2、3：每次后续事件使用的是已更新界面对应的处理器。不能把“一次处理器里的三次 setter”与“三次分开的点击”混为一谈。"],"\n",["P",{},"跨过异步等待之后，也不要承诺整个业务过程只有一次渲染。批处理是界面更新安排，不提供网络请求与本地状态的原子事务。例如“保存成功，再更新列表”需要处理请求失败，不能因为两个 setter 常被一起处理就假定数据已经可靠保存。"],"\n",["P",{},"遇到必须同步读取提交后 DOM 的第三方集成，React 有相应逃生 API，但它们不会改变当前快照变量。大多数业务无需强制同步提交，先让状态流向下一轮界面就足够了。"],"\n",["H3",{"id":"延迟回调可以有意使用点击时的内容"},"延迟回调可以有意使用点击时的内容"],"\n",["P",{},"这个示例模拟“稍后发送”。输入文字，点击发送，再立刻改输入框；一秒后观察结果："],"\n",["DIV",{"class":"code-block","data-language":"tsx"},["DIV",{"class":"code-block__bar"},["SPAN",{},"tsx"],["BUTTON",{"type":"button","class":"code-copy"},"复制代码"]],["PRE",{"class":"hljs"},["CODE",{},["SPAN",{"class":"hljs-keyword"},"import"]," { useEffect, useRef, useState } ",["SPAN",{"class":"hljs-keyword"},"from"]," ",["SPAN",{"class":"hljs-string"},"'react'"],";\n\n",["SPAN",{"class":"hljs-keyword"},"export"]," ",["SPAN",{"class":"hljs-keyword"},"default"]," ",["SPAN",{"class":"hljs-keyword"},"function"]," ",["SPAN",{"class":"hljs-title function_"},"App"],"(",["SPAN",{"class":"hljs-params"}],") {\n  ",["SPAN",{"class":"hljs-keyword"},"const"]," [draft, setDraft] = ",["SPAN",{"class":"hljs-title function_"},"useState"],"(",["SPAN",{"class":"hljs-string"},"'先学表单'"],");\n  ",["SPAN",{"class":"hljs-keyword"},"const"]," [sent, setSent] = ",["SPAN",{"class":"hljs-title function_"},"useState"],"(",["SPAN",{"class":"hljs-string"},"'尚未发送'"],");\n  ",["SPAN",{"class":"hljs-keyword"},"const"]," [pending, setPending] = ",["SPAN",{"class":"hljs-title function_"},"useState"],"(",["SPAN",{"class":"hljs-literal"},"false"],");\n  ",["SPAN",{"class":"hljs-keyword"},"const"]," timer = useRef<",["SPAN",{"class":"hljs-title class_"},"ReturnType"],"<",["SPAN",{"class":"hljs-keyword"},"typeof"]," ",["SPAN",{"class":"hljs-built_in"},"setTimeout"],"> | ",["SPAN",{"class":"hljs-literal"},"null"],">(",["SPAN",{"class":"hljs-literal"},"null"],");\n\n  ",["SPAN",{"class":"hljs-title function_"},"useEffect"],"(",["SPAN",{"class":"hljs-function"},"() =>"]," ",["SPAN",{"class":"hljs-function"},"() =>"]," {\n    ",["SPAN",{"class":"hljs-keyword"},"if"]," (timer.",["SPAN",{"class":"hljs-property"},"current"]," !== ",["SPAN",{"class":"hljs-literal"},"null"],") ",["SPAN",{"class":"hljs-built_in"},"clearTimeout"],"(timer.",["SPAN",{"class":"hljs-property"},"current"],");\n  }, []);