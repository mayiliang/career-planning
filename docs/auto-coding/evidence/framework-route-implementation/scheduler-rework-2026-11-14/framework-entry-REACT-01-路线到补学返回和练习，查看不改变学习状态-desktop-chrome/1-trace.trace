,["SPAN",{"class":"language-xml"},["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"main"],">"],"\n      ",["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"h1"],">"],"延迟发送",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"h1"],">"],"\n      ",["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"label"]," ",["SPAN",{"class":"hljs-attr"},"htmlFor"],"=",["SPAN",{"class":"hljs-string"},"\"draft\""],">"],"草稿",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"label"],">"],"\n      ",["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"input"]," ",["SPAN",{"class":"hljs-attr"},"id"],"=",["SPAN",{"class":"hljs-string"},"\"draft\""]," ",["SPAN",{"class":"hljs-attr"},"value"],"=",["SPAN",{"class":"hljs-string"},"{draft}"]," ",["SPAN",{"class":"hljs-attr"},"onChange"],"=",["SPAN",{"class":"hljs-string"},"{event"]," =>"]," setDraft(event.target.value)} />\n      ",["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"button"]," ",["SPAN",{"class":"hljs-attr"},"type"],"=",["SPAN",{"class":"hljs-string"},"\"button\""]," ",["SPAN",{"class":"hljs-attr"},"disabled"],"=",["SPAN",{"class":"hljs-string"},"{pending}"]," ",["SPAN",{"class":"hljs-attr"},"onClick"],"=",["SPAN",{"class":"hljs-string"},"{sendLater}"],">"],"\n        {pending ? '等待发送' : '一秒后发送'}\n      ",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"button"],">"],"\n      ",["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"p"]," ",["SPAN",{"class":"hljs-attr"},"role"],"=",["SPAN",{"class":"hljs-string"},"\"status\""],">"],"发送内容：{sent}",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"p"],">"],"\n    ",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"main"],">"]],"\n  );\n}\n"]],"\n"],["P",{},"假设点击时是“先学表单”，随后改成“再学 React”，发送结果仍是“先学表单”。对“提交点击时已确认的内容”来说，这正是合理结果。",["CODE",{},"messageAtClick"]," 把需求写得更明确，即使直接读取这个处理器捕获的 ",["CODE",{},"draft"],"，也是同一张快照。"],"\n",["P",{},"示例用 ref 保存定时器句柄，因为它需要跨渲染保留，但句柄本身不需要显示；Effect 只负责卸载时清理这个外部计时器。当前是否等待与已发送内容仍用 state，因为它们影响界面。这里无需深入 Effect 全部规则，先区分“显示数据”和“外部资源句柄”。"],"\n",["P",{},"如果希望两个延迟回调分别累加计数，应让它们调用 ",["CODE",{},"setCount(previous => previous + 1)"],"。如果都闭包读取某轮为 0 的 ",["CODE",{},"count"]," 再设置 ",["CODE",{},"count + 1"],"，两次替换的目标仍是 1。等待时间从 20 毫秒换成 40 毫秒，不会自动让闭包切换到另一轮快照。"],"\n",["P",{},"如果需求是“执行时读取最新输入”，应重新设计明确的数据通道；ref 可以作为某些集成的手段，但不应让所有显示状态都绕过 setter。异步结果能否覆盖当前页面，则还涉及 ",["A",{"href":"/knowledge/materials/js-05-promise-errors-async-control-flow.md/js-05#%E6%96%B0%E8%AF%B7%E6%B1%82%E5%BC%80%E5%A7%8B%E5%90%8E%E6%97%A7%E8%AF%B7%E6%B1%82%E7%9A%84%E6%B8%85%E7%90%86%E4%B9%9F%E5%8F%AF%E8%83%BD%E8%BF%87%E6%9C%9F"},"JS-05 的旧请求与清理",["SPAN",{"class":"material-reading-badge","data-state":"completed"},"已看完"]],"，不能只用“闭包旧了”解释全部竞态。"],"\n",["H3",{"id":"用手动释放回调固定观察顺序"},"用手动释放回调固定观察顺序"],"\n",["P",{},"真实定时器受机器调度影响。本练习把“稍后执行”变成两个明确的释放按钮：保存的函数仍是闭包，只把运行时机交给操作者。两个回调必须在同一次点击中创建，不能分两次预约。"],"\n",["DIV",{"class":"code-block","data-language":"tsx"},["DIV",{"class":"code-block__bar"},["SPAN",{},"tsx"],["BUTTON",{"type":"button","class":"code-copy"},"复制代码"]],["PRE",{"class":"hljs"},["CODE",{},["SPAN",{"class":"hljs-keyword"},"import"]," { useLayoutEffect, useRef, useState } ",["SPAN",{"class":"hljs-keyword"},"from"]," ",["SPAN",{"class":"hljs-string"},"'react'"],";\n\n",["SPAN",{"class":"hljs-keyword"},"export"]," ",["SPAN",{"class":"hljs-keyword"},"default"]," ",["SPAN",{"class":"hljs-keyword"},"function"]," ",["SPAN",{"class":"hljs-title function_"},"App"],"(",["SPAN",{"class":"hljs-params"}],") {\n  ",["SPAN",{"class":"hljs-keyword"},"const"]," [count, setCount] = ",["SPAN",{"class":"hljs-title function_"},"useState"],"(",["SPAN",{"class":"hljs-number"},"0"],");\n  ",["SPAN",{"class":"hljs-keyword"},"const"]," jobs = useRef<",["SPAN",{"class":"hljs-title class_"},"Array"],"<",["SPAN",{"class":"hljs-function"},"() =>"]," ",["SPAN",{"class":"hljs-built_in"},"void"],">>([]);\n  ",["SPAN",{"class":"hljs-variable language_"},"console"],"