ss":"hljs-title function_"},"focus"],"();\n      ",["SPAN",{"class":"hljs-keyword"},"return"],";\n    }\n    status.",["SPAN",{"class":"hljs-property"},"textContent"]," = ",["SPAN",{"class":"hljs-string"},"`本页已接受：",["SPAN",{"class":"hljs-subst"},"${input.value}"],"（未发送到服务器）`"],";\n  });\n  input.",["SPAN",{"class":"hljs-title function_"},"addEventListener"],"(",["SPAN",{"class":"hljs-string"},"'input'"],", ",["SPAN",{"class":"hljs-function"},"() =>"]," {\n    status.",["SPAN",{"class":"hljs-property"},"textContent"]," = ",["SPAN",{"class":"hljs-string"},"''"],";\n    ",["SPAN",{"class":"hljs-keyword"},"if"]," (attempted) ",["SPAN",{"class":"hljs-title function_"},"validate"],"();\n  });\n"],["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"script"],">"],"\n",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"html"],">"],"\n"]],"\n"],["P",{},"依次尝试空提交、输入 ",["CODE",{},"reader"],"、输入 ",["CODE",{},"reader@example.com"],"。第一种显示必填错误并聚焦字段；第二种显示格式说明；最后错误消失，页面报告已接受。修改一个先前通过的值时，旧成功提示会清空，避免显示过时结论。"],"\n",["P",{},"这个例子在首次提交之前不不断纠正用户；提交失败之后，再随输入修正现有错误。错误说明通过描述关系连接到字段，",["CODE",{},"aria-invalid"]," 表示当前无效。它没有把每次敲键都设置成强制播报。"],"\n",["P",{},"对于多个字段，可以在顶部提供错误摘要和跳转链接，或聚焦第一个错误。选择哪种方式取决于表单长度和任务，不应同时让摘要、字段错误与弹窗反复宣布同一件事。客户端检查提升填写体验，服务端仍需检查数据与操作权限。"],"\n",["H3",{"id":"焦点表示键盘接下来会操作哪里"},"焦点表示键盘接下来会操作哪里"],"\n",["P",{},["STRONG",{},"焦点管理（focus management",["BUTTON",{"type":"button","class":"pronunciation-button","data-pronunciation-term":"focus management","data-pronunciation-src":"/pronunciation/b04/b5d69c42c4e9efd1.wav","aria-label":"播放“focus management”的美式发音","title":"播放“focus management”的美式发音"},["SPAN",{"aria-hidden":"true"},"🔊"]],"）"]," 可以从一个简单观察开始：连续按 Tab，看每一步落在哪里，是否看得见位置，能否完成同样的任务。"],"\n",["P",{},"原生交互元素通常已经参与 Tab 顺序。让 DOM 顺序符合阅读顺序，再用 CSS 排版，通常比用 ",["CODE",{},"tabindex=\"1\""],"、",["CODE",{},"2"],"、",["CODE",{},"3"]," 硬排更稳定。正值 tabindex 会先于普通顺序参与导航，页面新增一个按钮时很容易打乱整条路径。"],"\n",["P",{},["CODE",{},"tabindex=\"0\""]," 让元素进入正常 Tab 顺序，但不会附赠角色与键盘激活；",["CODE",{},"tabindex=\"-1\""]," 允许脚本聚焦，通常不参加顺序 Tab，适合错误摘要或需要定位的静态标题。不要把每一段文字都放进 Tab 顺序，阅读文本和操作控件是两种不同任务。"],"\n",["P",{},"焦点必须可见。可以通过 ",["CODE",{},":focus-visible"]," 设置清楚的轮廓与间距，不要全局移除 outline 后不提供替代。键盘定位依靠的是可识别的当前位置，单纯改变很浅的颜色可能不够。"],"\n",["P",{},"内容较长的页面还可以在顶部提供跳转到主要内容的链接，减少每次都穿过导航的负担。缩放后、桌面窗口变窄后，同样要能看到标签、错误和焦点；这属于桌面阅读的基本可用性。"],"\n",["H3",{"id":"用原生-dialog-完成一次进出弹窗"},"用原生 dialog 完成一次进出弹窗"],"\n",["P",{},"弹窗不是把一个盒子盖到页面中间就结束。用户进入后，需要知道弹窗是什么、从哪里开始操作、如何退出、退出后回到哪里。下面是可直接保存的完整示例："],"\n",["DIV",{"class":"code-block","data-language":"html"},["DIV",{"class":"code-block__bar"},["SPAN",{},"html"],["BUTTON",{"type":"button","class":"code-copy"},"复制代码"]],["PRE",{"class":"hljs"},["CODE",{},["SPAN",{"class":"hljs-meta"},"<!doctype ",["SPAN",{"class":"hljs-keyword"},"html"],">"],"\n",["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"html"]," ",["SPAN",{"class":"hljs-attr"},"lang"],"=",["SPAN",{"class":"hljs-string"},"\"zh-CN\""],">"],"\n",["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"meta"]," ",["SPAN",{"class":"hljs-attr"},"charset"],"=",["SPAN",{"class":"hljs-string"},"\"utf-8\""],">"],"\n",["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"title"],">"],"阅读设置弹窗示例",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"title"],">"],"\n",["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"button"]," ",["SPAN",{"class":"hljs-attr"},"id"],"=",["SPAN",{"class":"hljs-string"},"\"open-settings\""]," ",["SPAN",{"class":"hljs-attr"},"type"],"=",["SPAN",{"class":"hljs-string"},"\"button\""],">"],"阅读设置",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"button"],">"],"\n",["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"p"]," ",["SPAN",{"class":"hljs-attr"},"id"],"=",["SPAN",{"class":"hljs-string"},"\"settings-status\""]," ",["SPAN",{"class":"hljs-attr"},"role"],"=",["SPAN",{"class":"hljs-string"},"\"status\""],">"],"当前为舒适间距",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"p"],">"],"\n",["SPAN",{"