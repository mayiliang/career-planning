,["TH",{},"入队过程"],"\n",["TH",{},"等界面提交后观察"],"\n"],"\n"],"\n",["TBODY",{},"\n",["TR",{},"\n",["TD",{},"点击一次“值式三次”"],"\n",["TD",{},"替换 1、替换 1、替换 1"],"\n",["TD",{},"1"],"\n"],"\n",["TR",{},"\n",["TD",{},"点击一次“函数三次”"],"\n",["TD",{},"0→1→2→3"],"\n",["TD",{},"3"],"\n"],"\n",["TR",{},"\n",["TD",{},"分别点击三次“值式三次”，每次等 output 更新"],"\n",["TD",{},"各事件读 0、1、2，各提交三份相同替换值"],"\n",["TD",{},"依次 1、2、3"],"\n"],"\n",["TR",{},"\n",["TD",{},"预约值式回调→函数三次→释放一次→再释放一次"],"\n",["TD",{},"预约捕获 0；先累加至 3；两个回调各替换成 1"],"\n",["TD",{},"0→3→1→1，两个 callback snapshot 都为 0"],"\n"],"\n",["TR",{},"\n",["TD",{},"预约函数回调→函数三次→释放一次→再释放一次"],"\n",["TD",{},"回调仍捕获 0，但 updater 接前一步结果"],"\n",["TD",{},"0→3→4→5，两个 callback snapshot 都为 0"],"\n"],"\n"],"\n"],"\n",["P",{},"按事件、回调、render、commit observation 分栏保存控制台记录，断言 output 和回调快照，不断言 render 或 commit 的固定次数。第二次替换成 1 可能没有新的 DOM 变化；日志多并不表示用户多点击。复测仅把初始值从 0 改成 10，得到值式单次 11、函数单次 13、三次独立点击 11/12/13，延迟值式 13→11→11、延迟函数式 13→14→15。"],"\n",["H3",{"id":"用相同输入复现纯度错误"},"用相同输入复现纯度错误"],"\n",["P",{},"下面是可独立执行的确定性反例，用普通函数模拟组件中计算列表的那一步。它不依赖两次 Date.now() 是否落在不同毫秒："],"\n",["DIV",{"class":"code-block","data-language":"js"},["DIV",{"class":"code-block__bar"},["SPAN",{},"js"],["BUTTON",{"type":"button","class":"code-copy"},"复制代码"]],["PRE",{"class":"hljs"},["CODE",{},["SPAN",{"class":"hljs-keyword"},"function"]," ",["SPAN",{"class":"hljs-title function_"},"impure"],"(",["SPAN",{"class":"hljs-params"},"items"],") { items.",["SPAN",{"class":"hljs-title function_"},"push"],"(",["SPAN",{"class":"hljs-string"},"'占位'"],"); ",["SPAN",{"class":"hljs-keyword"},"return"]," items.",["SPAN",{"class":"hljs-title function_"},"join"],"(",["SPAN",{"class":"hljs-string"},"','"],"); }\n",["SPAN",{"class":"hljs-keyword"},"function"]," ",["SPAN",{"class":"hljs-title function_"},"pure"],"(",["SPAN",{"class":"hljs-params"},"items"],") { ",["SPAN",{"class":"hljs-keyword"},"return"]," [...items, ",["SPAN",{"class":"hljs-string"},"'占位'"],"].",["SPAN",{"class":"hljs-title function_"},"join"],"(",["SPAN",{"class":"hljs-string"},"','"],"); }\n",["SPAN",{"class":"hljs-keyword"},"const"]," badInput = [",["SPAN",{"class":"hljs-string"},"'资料'"],"];\n",["SPAN",{"class":"hljs-keyword"},"const"]," bad = [",["SPAN",{"class":"hljs-title function_"},"impure"],"(badInput), ",["SPAN",{"class":"hljs-title function_"},"impure"],"(badInput)];\n",["SPAN",{"class":"hljs-keyword"},"const"]," goodInput = [",["SPAN",{"class":"hljs-string"},"'资料'"],"];\n",["SPAN",{"class":"hljs-keyword"},"const"]," good = [",["SPAN",{"class":"hljs-title function_"},"pure"],"(goodInput), ",["SPAN",{"class":"hljs-title function_"},"pure"],"(goodInput)];\n",["SPAN",{"class":"hljs-variable language_"},"console"],".",["SPAN",{"class":"hljs-title function_"},"log"],"(",["SPAN",{"class":"hljs-title class_"},"JSON"],".",["SPAN",{"class":"hljs-title function_"},"stringify"],"({ bad, badInput, good, goodInput }));\n",["SPAN",{"class":"hljs-comment"},"// => {\"bad\":[\"资料,占位\",\"资料,占位,占位\"],\"badInput\":[\"资料\",\"占位\",\"占位\"],\"good\":[\"资料,占位\",\"资料,占位\"],\"goodInput\":[\"资料\"]}"],"\n",["SPAN",{"class":"hljs-keyword"},"if"]," (bad[",["SPAN",{"class":"hljs-number"},"0"],"] === bad[",["SPAN",{"class":"hljs-number"},"1"],"] || badInput.",["SPAN",{"class":"hljs-property"},"length"]," !== ",["SPAN",{"class":"hljs-number"},"3"],") ",["SPAN",{"class":"hljs-keyword"},"throw"]," ",["SPAN",{"class":"hljs-keyword"},"new"]," ",["SPAN",{"class":"hljs-title class_"},"Error"],"(",["SPAN",{"class":"hljs-string"},"'未复现输入污染'"],");\n",["SPAN",{"class":"hljs-keyword"},"if"]," (good[",["SPAN",{"class":"hljs-number"},"0"],"] !== good[",["SPAN",{"class":"hljs-number"},"1"],"] || goodInput.",["SPAN",{"class":"hljs-property"},"length"]," !== ",["SPAN",{"class":"hljs-number"},"1"],") ",["SPAN",{"class":"hljs-keyword"},"throw"]," ",["SPAN",{"class":"hljs-keyword"},"new"]," ",["SPAN",{"class":"hljs-title class_"},"Error"],"(",["SPAN",{"class":"hljs-string"},"'纯计算结果错误'"],");\n"]],"\n"],["P",{},"错误版本第二次输出“资料,占位,占位”，输入也被污染；正确版本两次都输出“资料,占位”，输入保持一项。把同样的 push 放进组件 render 就违反相同规则。Date.now 的输出依赖外部时钟，因此不能据同一输入推导；但两次读数也可能相等，不以一次实验恰好相等证明纯度。"],"\n",["H3",{"id":"纯渲染允许-react-重新计算"},"纯渲染允许 React 重新计算"],"\n",["P",{},"React 可能重新执行组件，甚至不采用某一次计算结果。如果 render 每执行一次就修改外部数据，那么用户没有看到的计算也会留下痕迹。 ",["STRONG",{},"组件纯度（component purity",["BUTTON",{"type":"button","class":"pronunciation-button","data-pronunciation-term":"component purity","data-pronunciation-src":"/pronunciation/b04/5de9cf15f2b9de55.wav","aria-label":"播放“component purity”的美式发音","title":"播放“component purity”的美式发音"},["SPAN",{"aria-hidden":"true"},"🔊"]],"）"]," 因此有两个实际要求：相同输入得到相同描述；计算过程不修改已有的外部世界。"],"\n",["P",{},"比如传入三条资料，组件直接 ",["CODE",{},"lessons.push(...)"]," 添加一行占位，第二次调用就多出第二行占位。换成每次创建自己的新数组，再排序或追加，就不会污染输入："],"\n",["DIV",{"class":"code-block","data-language":"tsx"},["DIV",{"class":"code-block__bar"},["SPAN",{},"tsx"],["BUTTON",{"type":"button","class":"code-copy"},"复制代码"]],["PRE",{"class":"hljs"},["CODE",{},["SPAN",{"class":"hljs-keyword"},"type"]," ",["SPAN",{"class":"hljs-title class_"},"Lesson"]," = { ",["SPAN",{"class":"hljs-attr"},"id"],": ",["SPAN",{"class":"hljs-built_in"},"string"],"; ",["SPAN",{"class":"hljs-attr"},"title"],": ",["SPAN",{"class":"hljs-built_in"},"string"],"; ",["SPAN",{"class":"hljs-attr"},"minutes"],": ",["SPAN",{"class":"hljs-built_in"},"number"]," };\n",["SPAN",{"class":"hljs-keyword"},"const"]," ",["SPAN",{"class":"hljs-attr"},"lessons"],": ",["SPAN",{"class":"hljs-keyword"},"readonly"]," ",["SPAN",{"class":"hljs-title class_"},"Lesson"],"[] = [\n  { ",["SPAN",{"class":"hljs-attr"},"id"],": ",["SPAN",{"class":"hljs-string"},"'snapshot'"],", ",["SPAN",{"class":"hljs-attr"},"title"],": ",["SPAN",{"class":"hljs-string"},"'状态快照'"],", ",["SPAN",{"class":"hljs-attr"},"minutes"],": ",["SPAN",{"class":"hljs-number"},"30"]," },\n  { ",["SPAN",{"class":"hljs-attr"},"id"],": ",["SPAN",{"class":"hljs-string"},"'form'"],", ",["SPAN",{"class":"hljs-attr"},"title"],": ",["SPAN",{"class":"hljs-string"},"'HTML 表单'"],", ",["SPAN",{"class":"hljs-attr"},"minutes"],": ",["SPAN",{"class":"hljs-number"},"25"]," },\n];\n",["SPAN",{"class":"hljs-keyword"},"function"]," ",["SPAN",{"class":"hljs-title function_"},"ReadingList"],"(",["SPAN",{"class":"hljs-params"},"{ items }: { items: ",["SPAN",{"class":"hljs-keyword"},"readonly"]," Lesson[] }"],") {\n  ",["SPAN",{"class":"hljs-keyword"},"const"]," sorted = [...items].",["SPAN",{"class":"hljs-title function_"},"sort"],"(",["SPAN",{"class":"hljs-function"},"(",["SPAN",{"class":"hljs-params"},"a, b"],") =>"]," a.",["SPAN",{"class":"hljs-property"},"minutes"]," - b.",["SPAN",{"class":"hljs-property"},"minutes"],");\n  ",["SPAN",{"class":"hljs-keyword"},"return"]," ",["SPAN",{"class":"language-xml"},["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"ul"],">"],"{sorted.map(item => ",["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"li"]," ",["SPAN",{"class":"hljs-attr"},"key"],"=",["SPAN",{"class":"hljs-string"},"{item.id}"],">"],"{item.title}：{item.minutes} 分钟",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"li"],">"],")}",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"ul"],">"]],";\n}\n",["SPAN",{"class":"hljs-keyword"},"export"]," ",["SPAN",{"class":"hljs-keyword"},"default"]," ",["SPAN",{"class":"hljs-keyword"},"function"]," ",["SPAN",{"class":"hljs-title function_"},"App"],"(",["SPAN",{"class":"hljs-params"}],") {\n  ",["SPAN",{"class":"hljs-keyword"},"return"]," ",["SPAN",{"class":"language-xml"},["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"main"],">"],["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"h1"],">"],"按用时排序",["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"h1"],">"],["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"ReadingList"]," ",["SPAN",{"class":"hljs-attr"},"items"],"=",["SPAN",{"class":"hljs-string"},"{lessons}"]," />"],["SPAN",{"class":"hljs-tag"},"<",["SPAN",{"class":"hljs-name"},"ReadingList"]," ",["SPAN",{"class":"hljs-attr"},"items"],"=",["SPAN",{"class":"hljs-string"},"{lessons}"]," />"],["SPAN",{"class":"hljs-tag"},"</",["SPAN",{"class":"hljs-name"},"main"],">"]],";\n}\n"]],"\n"],["P",{},"两份列表都先显示 HTML 表单。每次调用都会新建 ",["CODE",{},"sorted"],"，排序只修改这份局部数组。局部变更可以是纯计算的一部分；禁止的是修改此前就存在、可能被其他渲染共享的对象。注意浅拷贝只隔离了数组，若继续修改 ",["CODE",{},"item.title"],"，仍会碰到共享元素。"],"\n",["P",{},"时间和随机数也值得留意。",["CODE",{},"Date.now()"]," 没有像写存储那样直接改变外部世界，却会让同一输入的输出依赖调用时刻，因而不满足幂等的渲染要求。需要“点击时记录时间”时，在事件里取得时间并存入 state；需要时钟时，由可清理的外部同步定期更新状态，再让 render 格式化该状态。"],"\n",["P",{},"不要在 render 中发请求、操作存储、建立订阅或直接改 DOM。用户动作对应事件处理器；与外部系统持续同步才考虑 Effect。render 保持为可以重新计算的描述。"],"\n",["H3",{"id":"strict-mode-的额外调用不是额外点击"},"Strict Mode 的额外调用不是额外点击"],"\n",["P",{},"开发环境使用 ",["STRONG",{},"Strict Mode"],["BUTTON",{"type":"button","class":"pronunciation-button","data-pronunciation-term":"Strict Mode","data-pronunciation-src":"/pronunciation/b04/f5cc124b70c8e577.wav","aria-label":"播放“Strict Mode”的美式发音","title":"播放“Strict Mode”的美式发音"},["SPAN",{"aria-hidden":"true"},"🔊"]]," 时，React 会额外调用某些应当保持纯粹的函数，并执行额外的 Effect 或 ref 清理检查。检查的具体范围与 Strict Mode 放置位置有关；不能把某个日志次数当成所有配置下的固定公式。"],"\n",["P",{},"组件函数和 updater 可能被额外调用，但一次真实点击不会因此自动调用两次事件处理器。看到两条 render 日志，先判断它记录的是计算、Effect 建立，还是已经发生的服务端操作，不要直接认定 React “把请求发了两次”。"],"\n",["P",{},"如果重复执行暴露出列表越来越长，检查是否修改 props；如果订阅越来越多，检查清理是否对称。关闭 Strict Mode 可能暂时隐藏现象，却没有解决那些在重新挂载或重做计算时仍会出现的问题。"],"\n",["P",{},"纯度也不表示组件必须永远不变化。用户输入改变后，组件当然可以返回不同内容。它要求的是变化有明确输入和发生位置，让重新计算本身不偷偷改变业务事实。"],"\n",["H3",{"id":"组件身份决定草稿保留还是重置"},"组件身份决定草稿保留还是重置"],"\n",["P",{},"React 把状态关联到渲染树中的位置和组件身份，并不是按函数名字在全局保存一份状态。下面切换两份资料时，编辑器的草稿应从新资料标题重新开始："],"\n",["DIV",{"class":"code-block","data-language":"tsx"},["DIV",{"class":"code-block__bar"},["SPAN",{},"tsx"],["BUTTON",{"type":"button","class":"code-copy"},"复制代码"]],["PRE",{"class":"hljs"},["CODE",{},["SPAN",{"class":"hljs-keyword"},"import"]," { useState } ",["SPAN",{"class":"hljs-keyword"},"from"]," ",["SPAN",{"class":"hljs-string"},"'react'"],";\n\n",["SPAN",{"class":"hljs-keyword"},"type"]," ",["SPAN",{"class":"hljs-title class_"}