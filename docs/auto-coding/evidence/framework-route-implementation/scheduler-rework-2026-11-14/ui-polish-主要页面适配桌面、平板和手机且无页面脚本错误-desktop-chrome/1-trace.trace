#5f6d7e;\n  --color-text-tertiary: #8995a4;\n  --color-focus: rgba(50,104,199,.18);\n  --color-blueprint: var(--color-primary);\n  --color-cool-sheet: var(--color-background);\n  --color-draft-ink: var(--color-text);\n  --color-moss-proof: var(--color-success);\n  --color-amber-review: var(--color-warning);\n  --color-redline: var(--color-danger);\n  --color-editorial-ink: #19312a;\n  --color-editorial-moss: #176a55;\n  --color-editorial-clay: #c2603f;\n  --color-editorial-paper: #fffefa;\n  --font-display: \"Avenir Next\", \"SF Pro Display\", \"PingFang SC\", sans-serif;\n  --font-body: Inter, \"SF Pro Text\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;\n  --font-mono: \"SFMono-Regular\", \"JetBrains Mono\", Consolas, monospace;\n  --space-base: 8px;\n  --space-xs: 4px;\n  --space-sm: 8px;\n  --space-md: 16px;\n  --space-lg: 24px;\n  --space-xl: 32px;\n  --radius-base: 12px;\n  --radius-sm: 8px;\n  --radius-md: 12px;\n  --radius-lg: 16px;\n  --radius-full: 999px;\n  --shadow-xs: 0 1px 2px rgba(26,42,67,.04);\n  --shadow-sm: 0 10px 30px rgba(26,42,67,.08);\n  --shadow-md: 0 22px 64px rgba(26,42,67,.14);\n  /* 兼容各业务页的语义变量，避免未定义变量让间距、圆角和状态色静默失效。 */\n  --surface-primary: var(--color-surface);\n  --surface-secondary: var(--color-surface-raised);\n  --surface-tertiary: #eef2f7;\n  --text-secondary: var(--color-text-secondary);\n  --text-tertiary: var(--color-text-tertiary);\n  --border-color: var(--color-border);\n  --color-bg-primary: var(--color-surface);\n  --color-error: var(--color-danger);\n  --color-warning-bg: #fff7e7;\n}\n* { box-sizing: border-box;\n}\nhtml { color-scheme: light; background: var(--color-background);\n}\nhtml,body,#app { min-height: 100%; margin: 0;\n}\nbody { font-family: var(--font-body); color: var(--color-text); line-height: 1.6; background:var(--color-background); -webkit-font-smoothing: antialiased;\n}\nbutton,input,textarea,select { font: inherit;\n}\nbutton { transition: transform .18s ease, color .18s ease, background .18s ease, border-color .18s ease, box-shadow .18s ease;\n}\nbutton:disabled { cursor: not-allowed;\n}\nbutton:not(:disabled):active { transform: translateY(1px) scale(.99);\n}\nbutton:focus-visible,a:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible { outline: 3px solid var(--color-focus); outline-offset: 2px;\n}\n::selection { color: var(--color-navy); background: #cfe0ff;\n}\n.sr-only { position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important;\n}\n\n/* 全局框架：安静的背景、清晰的导航与可收起的阅读空间。 */\n.app-root { display: grid; grid-template-columns: 224px minmax(0, 1fr); min-height: 100vh;\n}\n.app-root.sidebar-collapsed { grid-template-columns: 80px minmax(0, 1fr);\n}\n.skip-link { position: fixed; top: 10px; left: 10px; z-index: 5000; padding: 10px 16px; color: #fff; background: var(--color-navy); border-radius: 10px; transform: translateY(-160%);\n}\n.skip-link:focus { transform: translateY(0);\n}\n.side-nav { position: sticky; top: 0; z-index: 30; display: flex; flex-direction: column; height: 100vh; height: 100dvh; padding: 28px 16px 18px; background: #fcfdfd; border-right: 1px solid #e1e7ec; overflow-y: auto;\n}\n.nav-header { display: flex; align-items: center; gap: 10px; padding: 0 6px 36px;\n}\n.brand-mark { flex: 0 0 36px; width: 36px; height: 36px; border-radius: 11px;\n}\n.brand-copy { min-width: 0;\n}\n.app-title { color: #1a3044; font: 750 16px/1.3 var(--font-display); letter-spacing: -.025em; white-space: nowrap;\n}\n.brand-copy p { margin: 4px 0 0; color: #74818f; font-size: 10px; white-space: nowrap;\n}\n.nav-caption { margin: 0 14px 12px; color: #7a8795; font-size: 11px; letter-spacing: .08em;\n}\n.nav-list { display: grid; align-content: start; gap: 7px; margin: 0; padding: 0; list-style: none;\n}\n.nav-link { position: relative; display: flex; align-items: center; gap: 12px; min-height: 48px; padding: 8px 13px; color: #617080; text-decoration: none; border: 1px solid transparent; border-radius: 10px; transition: background .18s, color .18s, border-color .18s;\n}\n.nav-link:hover { color: #203d5c; background: #f0f4f8;\n}\n.nav-link.active { color: #285799; background: #eaf1fc; border-color: #dce7f7;\n}\n.nav-link.active::after { content: ''; position: absolute; right: 12px; width: 5px; height: 5px; background: #4b7cc2; border-radius: 50%;\n}\n.nav-glyph { display: grid; flex: 0 0 22px; place-items: center;\n}\n.nav-copy { min-width: 0;\n}\n.nav-copy strong { font-size: 13px; font-weight: 600;\n}\n.nav-footer { display: grid; gap: 20px; margin-top: auto; padding-top: 32px;\n}\n.service-state { display: flex; align-items: center; gap: 10px; margin: 0 9px; padding: 16px 4px 0; border-top: 1px solid #e4e9ee;\n}\n.service-state > span { flex: 0 0 6px; width: 6px; height: 6px; border-radius: 50%; box-shadow: 0 0 0 4px #edf5f1;\n}\n.service-state div { display: grid; gap: 3px;\n}\n.service-state strong { font-size: 11px; color: #566779; font-weight: 500;\n}\n.service-state small { color: #7a8795; font-size: 10px;\n}\n.main-area { min-width: 0;\n}\n.workspace-bar { height: 72px; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 0 clamp(20px, 2.7vw, 44px); border-bottom: 1px solid #e3e8ee; background: rgba(252, 253, 253, .9);\n}\n.workspace-location, .workspace-tools { display: flex; align-items: center; gap: 14px; min-width: 0;\n}\n.workspace-location { font-size: 12px;\n}\n.workspace-label, .breadcrumb-divider { color: #8793a1;\n}\n.current-location { color: #40556a; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;\n}\n.icon-button { display: grid; place-items: center; width: 36px; height: 36px; flex-shrink: 0; padding: 0; color: #6a7a8b; background: transparent; border: 1px solid transparent; border-radius: 8px; cursor: pointer;\n}\n.icon-button:hover { color: var(--color-primary); background: #edf2f8; border-color: #dee6ef;\n}\n.command-trigger { display: flex; align-items: center; gap: 12px; min-height: 38px; padding: 7px 10px; color: #778597; background: #f4f6f9; border: 1px solid #e2e7ed; border-radius: 9px; cursor: pointer;\n}\n.command-trigger:hover { color: var(--color-primary); border-color: #bed0eb; background: #fff;\n}\n.command-trigger .app-icon { width: 16px; height: 16px;\n}\n.command-trigger > span { font-size: 12px; padding-right: 36px;\n}\n.command-trigger kbd { padding: 1px 5px; border: 1px solid #dbe1e8; border-radius: 4px; background: #fff; font: 10px/1.5 var(--font-mono);\n}\n.mobile-settings { display: none;\n}\n.main-content { position: relative; min-width: 0; background: #f5f7fa;\n}\n.main-content:focus { outline: none;\n}\n.content-frame { width: 100%; max-width: 1780px; min-height: calc(100vh - 72px); margin: 0 auto; padding: clamp(20px, 2.7vw, 44px);\n}\n.route-shell { min-width: 0;\n}\n.route-enter-active, .route-leave-active { transition: opacity .14s ease, transform .16s ease;\n}\n.route-enter-from { opacity: 0; transform: translateY(5px);\n}\n.route-leave-to { opacity: 0;\n}\n.loading-state, .error-state, .empty-state { padding: 3rem; text-align: center; color: var(--color-text-secondary); background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 16px;\n}\n.sidebar-collapsed :is(.brand-copy, .nav-caption, .nav-copy, .service-state div) { display: none;\n}\n.sidebar-collapsed .side-nav { padding-inline: 12px;\n}\n.sidebar-collapsed .nav-header { justify-content: center; padding-inline: 0;\n}\n.sidebar-collapsed .nav-link { justify-content: center; padding-inline: 8px;\n}\n.sidebar-collapsed .nav-link.active::after { display: none;\n}\n.sidebar-collapsed .service-state { justify-content: center; margin: 0;\n}\n.sidebar-collapsed .sidebar-toggle .app-icon { transform: rotate(180deg);\n}\n@media (max-width: 1100px) and (min-width: 701px) {\n.app-root { grid-template-columns: 80px minmax(0, 1fr);\n}\n.side-nav { padding-inline: 12px;\n}\n.brand-copy, .nav-caption, .nav-copy, .service-state div, .sidebar-toggle { display: none;\n}\n.nav-header, .nav-link, .service-state { justify-content: center; padding-inline: 0;\n}\n.nav-link.active::after { display: none;\n}\n}\n@media (max-width: 700px) {\n.app-root, .app-root.sidebar-collapsed { display: block;\n}\n.side-nav, .sidebar-collapsed .side-nav { position: fixed; inset: auto 0 0; width: 100%; height: calc(68px + env(safe-area-inset-bottom)); padding: 6px 10px calc(6px + env(safe-area-inset-bottom)); background: rgba(252,253,253,.96); border: 0; border-top: 1px solid #dce4ed; box-shadow: 0 -4px 24px #1c304b08; backdrop-filter: blur(16px); overflow: visible;\n}\n.nav-header, .nav-caption, .nav-footer, .sidebar-toggle, .workspace-label, .breadcrumb-divider { display: none;\n}\n.nav-list { grid-template-columns: repeat(5, minmax(0, 1fr)); width: 100%; gap: 4px;\n}\n.nav-link, .sidebar-collapsed .nav-link { min-height: 54px; justify-content: center; flex-direction: column; gap: 4px; padding: 5px 0; border-radius: 9px;\n}\n.nav-link.active::after { display: none;\n}\n.nav-copy, .sidebar-collapsed .nav-copy { display: block;\n}\n.nav-copy strong { font-size: 10px;\n}\n.nav-glyph { flex-basis: auto;\n}\n.nav-glyph .app-icon { width: 20px; height: 20px;\n}\n.workspace-bar { height: 58px; padding: 0 18px; gap: 8px;\n}\n.workspace-location { font-size: 13px; font-weight: 650;\n}\n.workspace-tools { gap: 8px;\n}\n.command-trigger { justify-content: center; width: 36px; height: 36px; padding: 0; background: transparent; border-color: transparent;\n}\n.command-trigger > span, .command-trigger kbd { display: none;\n}\n.command-trigger .app-icon { width: 19px; height: 19px;\n}\n.mobile-settings { display: grid;\n}\n.content-frame { min-height: calc(100vh - 58px); padding: 24px 16px calc(156px + env(safe-area-inset-bottom));\n}\n}\n@media (prefers-reduced-motion: reduce) {\n*, *::before, *::after { scroll-behavior: auto !important; transition: none !important; animation: none !important;\n}\n}\n"]],"\n  ",["BODY",{},"\n    ",["DIV",{"id":"app","data-v-app":""},["DIV",{"class":"app-root"},["A",{"class":"skip-link","href":"#main-content"},"跳到主要内容"],["NAV",{"id":"primary-navigation","class":"side-nav","aria-label":"主导航"},["DIV",{"class":"nav-header"},["IMG",{"__playwright_current_src__":"http://127.0.0.1:42731/career-atlas-icon-192.png","class":"brand-mark","src":"/career-atlas-icon-192.png","alt":"","width":"38","height":"38","aria-hidden":"true"}],["DIV",{"class":"brand-copy"},["DIV",{"class":"app-title"},"Career Atlas"],["P",{},"AI 时代前端能力地图"]]],["P",{"class":"nav-caption"},"我的工作空间"],["UL",{"class":"nav-list"},"",["LI",{},["A",{"aria-current":"page","href":"/","class":"nav-link active","title":"学习台"},["SPAN",{"class":"nav-glyph"},["svg",{"data-v-54b59b04":"","class":"app-icon","width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"1.7","stroke-linecap":"round","stroke-linejoin":"round","aria-hidden":"true","focusable":"false"},["path",{"data-v-54b59b04":"","d":"M3 10.5 12 3l9 7.5M5 9v11h5v-6h4v6h5V9"}]]],["SPAN",{"class":"nav-copy"},["STRONG",{},"学习台"]]]],["LI",{},["A",{"href":"/knowledge/map","class":"nav-link","title":"知识体系"},["SPAN",{"class":"nav-glyph"},["svg",{"data-v-54b59b04":"","class":"app-icon","width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"1.7","stroke-linecap":"round","stroke-linejoin":"round","aria-hidden":"true","focusable":"false"},["path",{"data-v-54b59b04":"","d":"m3 5 6-2 6 2 6-2v16l-6 2-6-2-6 2V5Zm6-2v16m6-14v16"}]]],["SPAN",{"class":"nav-copy"},["STRONG",{},"知识体系"]]]],["LI",{},["A",{"href":"/notes","class":"nav-link","title":"笔记中心"},["SPAN",{"class":"nav-glyph"},["svg",{"data-v-54b59b04":"","class":"app-icon","width":"20","height":"20","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"1.7","stroke-linecap":"round","stroke-linejoin":"round","aria-hidden":"tru