ata-v-02f53d77":"","type":"button","class":"level-3"},"用一条线把概念连起来"],["BUTTON",{"data-v-02f53d77":"","type":"button","class":"level-3"},"参考与延伸阅读"],""]],["ARTICLE",{"__playwright_target__":"","data-v-02f53d77":"","class":"material-sheet","data-material-path":"/knowledge/materials/js-01-execution-context-scope-closure.md/js-01","data-reader-ready":"true"},["DIV",{"data-v-02f53d77":"","class":"chapter-intro"},["SPAN",{"data-v-02f53d77":""},"这一篇，读懂一个问题"],["H2",{"data-v-02f53d77":""},"函数从哪里读取变量？"],["UL",{"data-v-02f53d77":""},"",["LI",{"data-v-02f53d77":""},"沿源码找到变量所属的作用域"],["LI",{"data-v-02f53d77":""},"解释闭包读取变量与保存快照的区别"],["LI",{"data-v-02f53d77":""},"区分实例隔离、循环绑定和长期引用"],""]],["DIV",{"data-v-0b0b9f63":"","data-v-02f53d77":"","class":"markdown-renderer reader-content"},["ARTICLE",{"data-v-0b0b9f63":"","class":"markdown-body","aria-label":"Markdown 内容","data-pronunciations":"ready"},["H2",{"id":"js-01-执行上下文作用域与闭包"},"JS-01 执行上下文、作用域与闭包"],"\n",["P",{},"为什么函数已经执行完，里面的变量还能继续使用？为什么同一个回调，换个地方调用也找不到那个地方的同名变量？这两个看似分开的问题，其实都在问： ",["STRONG",{},"一个函数究竟从哪里读取变量。"]],"\n",["P",{},"这篇文章从普通函数调用开始，逐步走到闭包。读完后，你应该能顺着源码解释变量的来处，分清“这一次调用的局部状态”和“多个函数共用的状态”，也能判断回调何时需要清理。"],"\n",["H3",{"id":"学习前先确认"},"学习前先确认"],"\n",["UL",{},"\n",["LI",{},"直接前置：",["A",{"href":"/knowledge/materials/javascript-functions-and-callbacks.md/prejs-02"},"函数、参数、返回值与回调",["SPAN",{"class":"material-reading-badge","data-state":"unread"},"未读"]],"。只需能读懂函数定义、调用和返回函数；变量基础在这篇前置短文中另有入口。"],"\n"],"\n",["P",{},"本文示例可分别复制到现代浏览器控制台运行。每个代码块都自带所需定义，",["CODE",{},"// =>"]," 后面是应看到的输出。先运行，再改一个值观察变化，比一开始记术语更容易建立直觉。"],"\n",["H3",{"id":"从一次函数调用看起"},"从一次函数调用看起"],"\n",["P",{},"先看一个最普通的价格计算："],"\n",["DIV",{"class":"code-block","data-language":"js"},["DIV",{"class":"code-block__bar"},["SPAN",{},"js"],["BUTTON",{"type":"button","class":"code-copy"},"复制代码"]],["PRE",{"class":"hljs"},["CODE",{},["SPAN",{"class":"hljs-keyword"},"function"]," ",["SPAN",{"class":"hljs-title function_"},"calculatePrice"],"(",["SPAN",{"class":"hljs-params"},"unitPrice, quantity"],") {\n  ",["SPAN",{"class":"hljs-keyword"},"const"]," subtotal = unitPrice * quantity;\n  ",["SPAN",{"class":"hljs-keyword"},"return"]," subtotal;\n}\n\n",["SPAN",{"class":"hljs-variable language_"},"console"],".",["SPAN",{"class":"hljs-title function_"},"log"],"(",["SPAN",{"class":"hljs-title function_"},"calculatePrice"],"(",["SPAN",{"class":"hljs-number"},"12"],", ",["SPAN",{"class":"hljs-number"},"2"],")); ",["SPAN",{"class":"hljs-comment"},"// => 24"],"\n",["SPAN",{"class":"hljs-variable language_"},"console"],".",["SPAN",{"class":"hljs-title function_"},"log"],"(",["SPAN",{"class":"hljs-title function_"},"calculatePrice"],"(",["SPAN",{"class":"hljs-number"},"12"],", ",["SPAN",{"class":"hljs-number"},"5"],")); ",["SPAN",{"class":"hljs-comment"},"// => 60"],"\n"]],"\n"],["P",{},"两次调用用的是同一段函数代码，却各自有一组参数和局部变量。第一次的 ",["CODE",{},"quantity"]," 是 ",["CODE",{},"2"],"，第二次是 ",["CODE",{},"5"],"。它们并不是让同一个局部变量来回换值，而是两次调用分别建立了自己的执行环境。"],"\n",["P",{},"可以把",["STRONG",{},"执行上下文（execution context",["BUTTON",{"type":"button","class":"pronunciation-button","data-pronunciation-term":"execution context","data-pronunciation-src":"/pronunciation/b01/e5d90f979d76cf4c.wav","aria-label":"播放“execution context”的美式发音","title":"播放“execution context”的美式发音"},["SPAN",{"aria-hidden":"true"},"🔊"]],"）"]," 理解为：为了执行当前这段代码，JavaScript 需要保存的一组信息。例如正在执行哪个函数、局部变量在哪里，以及代码执行到了哪里。它是解释运行过程的模型，不是要求你猜测引擎把每个变量放在内存的哪个位置。"],"\n",["P",{},"当一个函数调用另一个函数时，当前函数暂时等着，被调用的函数先执行；返回以后，再从原来的位置继续。这种“后来调用的先返回”的顺序，由",["STRONG",{},"调用栈（call stack",["BUTTON",{"type":"button","class":"pronunciation-button","data-pronunciation-term":"call stack","data-pronunciation-src":"/pronunciation/b01/895930fc6596c35f.wav","aria-label":"播放“call stack”的美式发音","title":"播放“call stack”的美式发音"},["SPAN",{"aria-hidden":"true"},"🔊"]],"）"]," 描述。"],"\n",["DIV",{"class":"code-block","data-language":"js"},["DIV",{"class":"code-block__bar"},["SPAN",{},"js"],["BUTTON",{"type":"button","class":"code-copy"},"复制代码"]],["PRE",{"class":"hljs"},["CODE",{},["SPAN",{"class":"hljs-keyword"},"function"]," ",["SPAN",{"class":"hljs-title function_"},"formatPrice"],"(",["SPAN",{"class":"hljs-params"},"value"],") {\n  ",["SPAN",{"class":"hljs-variable language_"},"console"],".",["SPAN",{"class":"hljs-title function_"},"log"],"(",["SPAN",{"class":"hljs-string"},"'进入 formatPrice'"],");\n  ",["SPAN",{"class":"hljs-keyword"},"return"]," ",["SPAN",{"class":"hljs-string"},"`¥",["SPAN",{"class":"hljs-subst"},"${value}"],"`"],";\n}\n\n",["SPAN",{"class":"hljs-keyword"},"function"]," ",["SPAN",{"class":"hljs-title function_"},"showPrice"],"(",["SPAN",{"class":"hljs-params"}],") {\n  ",["SPAN",{"class":"hljs-variable language_"},"console"],".",["SPAN",{"class":"hljs-title function_"},"log"],"(",["SPAN",{"class":"hljs-string"},"'进入 showPrice'"],");\n  ",["SPAN",{"class":"hljs-keyword"},"const"]," text = ",["SPAN",{"class":"hljs-title function_"},"formatPrice"],"(",["SPAN",{"class":"hljs-number"},"24"],");\n  ",["SPAN",{"class":"hljs-variable language_"},"console"],".",["SPAN",{"class":"hljs-title function_"},"log"],"(text);\n}\n\n",["SPAN",{"class":"hljs-title function_"},"showPrice"],"();\n",["SPAN",{"class":"hljs-comment"},"// => 进入 showPrice"],"\n",["SPAN",{"class":"hljs-comment"},"// => 进入 formatPrice"],"\n",["SPAN",{"class":"hljs-comment"},"// => ¥24"],"\n"]],"\n"],["P",{},"调用栈回答的是“现在轮到谁执行”。它不直接回答“函数中的某个名字应该去哪里找”。后一个问题需要作用域。把这两个问题拆开，闭包就不必依赖“函数退出了，栈怎么还没消失”这样的猜想来解释。"],"\n",["H3",{"id":"名字沿源码的位置查找"},"名字沿源码的位置查找"],"\n",["P",{},["STRONG",{},"作用域（scope",["BUTTON",{"type":"button","class":"pronunciation-button","data-pronunciation-term":"scope","data-pronunciation-src":"/pronunciation/b01/5f161c9149882e0e.wav","aria-label":"播放“scope”的美式发音","title":"播放“scope”的美式发音"},["SPAN",{"aria-hidden":"true"},"🔊"]],"）"]," 决定一个名字能在哪些位置被访问。JavaScript 主要采用",["STRONG",{},"词法作用域（lexical scope",["BUTTON",{"type":"button","class":"pronunciation-button","data-pronunciation-term":"lexical scope","data-pronunciation-src":"/pronunciation/b01/e636e288262d2d65.wav","aria-label":"播放“lexical scope”的美式发音","title":"播放“lexical scope”的美式发音"},["SPAN",{"aria-hidden":"true"},"🔊"]],"）"],"：查找外层变量的方向，由函数在源码中定义的位置决定，而不是由调用位置决定。"],"\n",["DIV",{"class":"code-block","data-language":"js"},["DIV",{"class":"code-block__bar"},["SPAN",{},"js"],["BUTTON",{"type":"button","class":"code-copy"},"复制代码"]],["PRE",{"class":"hljs"},["CODE",{},["SPAN",{"class":"hljs-keyword"},"const"]," city = ",["SPAN",{"class":"hljs-string"},"'杭州'"],";\n\n",["SPAN",{"class":"hljs-keyword"},"function"]," ",["SPAN",{"class":"hljs-title function_"},"showCity"],"(",["SPAN",{"class":"hljs-params"}],") {\n  ",["SPAN",{"class":"hljs-keyword"},"return"]," city;\n}\n\n",["SPAN",{"class":"hljs-keyword"},"function"]," ",["SPAN",{"class":"hljs-title function_"},"visit"],"(",["SPAN",{"class":"hljs-params"}],") {\n  ",["SPAN",{"class":"hljs-keyword"},"const"]," city = ",["SPAN",{"class":"hljs-string"},"'成都'"],";\n  ",["SPAN",{"class":"hljs-keyword"},"return"]," ",["SPAN",{"class":"hljs-title function_"},"showCity"],"();\n}\n\n",["SPAN",{"class":"hljs-variable language_"},"console"],".",["SPAN",{"class":"hljs-title function_"},"log"],"(",["SPAN",{"class":"hljs-title function_"},"visit"],"()); ",["SPAN",{"class":"hljs-comment"},"// => 杭州"],"\n"]],"\n"],["P",{},["CODE",{},"showCity"]," 自己没有声明 ",["CODE",{},"city"],"，于是向它定义处的外层查找，找到 ",["CODE",{},"'杭州'"],"。虽然这次调用发生在 ",["CODE",{},"visit"]," 里面，但 ",["CODE",{},"visit"]," 的局部变量不在 ",["CODE",{},"showCity"]," 的外层作用域中，因此不会参与这次查找。"],"\n",["P",{},"读这种代码时，可以先圈出函数的定义，再沿源码中的嵌套关系向外看。不要从调用处反向寻找“最近执行过的同名变量”。前者是作用域关系，后者只是执行顺序，两者不能混用。"],"\n",["P",{},"如果内层也声明了同名变量，内层变量会",["STRONG",{},"遮蔽（shadowing",["BUTTON",{"type":"button","class":"pronunciation-button","data-pronunciation-term":"shadowing","data-pronunciation-src":"/pronunciation/b01/6dd015a84cac1a9a.wav","aria-label":"播放“shadowing”的美式发音","title":"播放“shadowing”的美式发音"},["SPAN",{"aria-hidden":"true"},"🔊"]],"）"]," 外层变量。遮蔽只是名字查找会先停在内层，并不意味着外层的值被改了。"],"\n",["DIV",{"class":"code-block","data-language":"js"},["DIV",{"class":"code-block__bar"},["SPAN",{},"js"],["BUTTON",{"type":"button","class":"code-copy"},"复制代码"]],["PRE",{"class":"hljs"},["CODE",{},["SPAN",{"class":"hljs-keyword"},"const"]," label = ",["SPAN",{"class":"hljs-string"},"'全站设置'"],";\n{\n  ",["SPAN",{"class":"hljs-keyword"},"const"]," label = ",["SPAN",{"class":"hljs-string"},"'当前页面'"],";\n  ",["SPAN",{"class":"hljs-variable language_"},"console"],".",["SPAN",{"class":"hljs-title function_"},"log"],"(label); ",["SPAN",{"class":"hljs-comment"},"// => 当前页面"],"\n}\n",["SPAN",{"class":"hljs-variable language_"},"console"],".",["SPAN",{"class":"hljs-title function_"},"log"],"(label); ",["SPAN",{"class":"hljs-comment"},"// => 全站设置"],"\n"]],"\n"],["P",{},"作用域也不等于花括号的数量。",["CODE",{},"if"],"、",["CODE",{},"for"]," 和独立代码块会为 ",["CODE",{},"let"],"、",["CODE",{},"const"]," 建立块级作用域；",["CODE",{},"var"]," 通常受所在函数约束，不会因为普通的 ",["CODE",{},"if"]," 块就产生独立作用域。对象字面量的花括号则是在描述属性，不是创建一层供变量查找的词法作用域。"],"\n",["H3",{"id":"声明之前为什么有时能读有时会报错"},"声明之前为什么有时能读有时会报错"],"\n",["P",{},"“声明提升”这个说法容易让人以为引擎把源码搬到了文件顶部。更准确的读法是：进入作用域时，某些名字已经被登记，但不同声明的初始化规则不同。"],"\n",["DIV",{"class":"code-block","data-language":"js"},["DIV",{"class":"code-block__bar"},["SPAN",{},"js"],["BUTTON",{"type":"button","class":"code-copy"},"复制代码"]],["PRE",{"class":"hljs"},["CODE",{},["SPAN",{"class":"hljs-keyword"},"function"]," ",["SPAN",{"class":"hljs-title function_"},"inspectDeclarations"],"(",["SPAN",{"class":"hljs-params"}],") {\n  ",["SPAN",{"class":"hljs-variable language_"},"console"],".",["SPAN",{"class":"hljs-title function_"},"log"],"(total); ",["SPAN",{"class":"hljs-comment"},"// => undefined"],"\n  ",["SPAN",{"class":"hljs-keyword"},"var"]," total = ",["SPAN",{"class":"hljs-number"},"3"],";\n\n  ",["SPAN",{"class":"hljs-keyword"},"try"]," {\n    ",["SPAN",{"class":"hljs-variable language_"},"console"],".",["SPAN",{"class":"hljs-title function_"},"log"],"(count);\n  } ",["SPAN",{"class":"hljs-keyword"},"catch"]," (error) {\n    ",["SPAN",{"class":"hljs-variable language_"},"console"],".",["SPAN",{"class":"hljs-title function_"},"log"],"(error.",["SPAN",{"class":"hljs-property"},"name"],"); ",["SPAN",{"class":"hljs-comment"},"// => ReferenceError"],"\n  }\n  ",["SPAN",{"class":"hljs-keyword"},"let"]," count = ",["SPAN",{"class":"hljs-number"},"4"],";\n  ",["SPAN",{"class":"hljs-variable language_"},"console"],".",["SPAN",{"class":"hljs-title function_"},"log"],"(count); ",["SPAN",{"class":"hljs-comment"},"// => 4"],"\n}\n",["SPAN",{"class":"hljs-title function_"},"inspectDeclarations"],"();\n"]],"\n"],["P",{},["CODE",{},"var total"]," 在函数开始执行时已经初始化为 ",["CODE",{},"undefined"],"，运行到赋值处才变成 ",["CODE",{},"3"],"。",["CODE",{},"let count"]," 的绑定虽然已经属于这个作用域，但直到执行声明时才完成初始化。此前这段时间叫",["STRONG",{},"暂时性死区（temporal dead zone",["BUTTON",{"type":"button","class":"pronunciation-button","data-pronunciation-term":"temporal dead zone","data-pronunciation-src":"/pronunciation/b01/f84cc66d508c00a3.wav","aria-label":"播放“temporal dead zone”的美式发音","title":"播放“temporal dead zone”的美式发音"},["SPAN",{"aria-hidden":"true"},"🔊"]],"）"],"，简称 TDZ。"],"\n",["P",{},"TDZ 中的变量不是“先去外层找找看”。只要当前作用域声明了这个名字，就会先找到当前绑定；它尚未初始化，读取便报错，即使外层恰好也有同名变量。"],"\n",["DIV",{"class":"code-block","data-language":"js"},["DIV",{"class":"code-block__bar"},["SPAN",{},"js"],["BUTTON",{"type":"button","class":"code-copy"},"复制代码"]],["PRE",{"class":"hljs"},["CODE",{},["SPAN",{"class":"hljs-keyword"},"const"]," theme = ",["SPAN",{"class":"hljs-string"},"'浅色'"],";\n{\n  ",["SPAN",{"class":"hljs-keyword"},"try"]," {\n    ",["SPAN",{"class":"hljs-variable language_"},"console"],".",["SPAN",{"class":"hljs-title function_"},"log"],"(theme);\n  } ",["SPAN",{"class":"hljs-keyword"},"catch"]," (error) {\n    ",["SPAN",{"class":"hljs-variable language_"},"console"],".",["SPAN",{"class":"hljs-title function_"},"log"],"(error.",["SPAN",{"class":"hljs-property"},"name"],"); ",["SPAN",{"class":"hljs-comment"},"// => ReferenceError"],"\n  }\n  ",["SPAN",{"class":"hljs-keyword"},"const"]," theme = ",["SPAN",{"class":"hljs-string"},"'深色'"],";\n  ",["SPAN",{"class":"hljs-variable language_"},"console"],".",["SPAN",{"class":"hljs-title function_"},"log"],"(theme); ",["SPAN",{"class":"hljs-comment"},"// => 深色"],"\n}\n"]],"\n"],["P",{},"普通函数声明在所在函数或模块的作用域初始化时就可供调用。赋给 ",["CODE",{},"const"]," 的函数表达式则要等到那条声明执行完成。不要把“函数能提前调用”推广成所有写法都一样；阅读旧式脚本时，块内函数声明还有历史兼容规则，现代代码尽量在模块或明确的函数作用域中定义它们。"],"\n",["P",{},"还有一个有用的区别：",["CODE",{},"typeof"]," 一个完全未声明的名字通常返回 ",["CODE",{},"'undefined'"],"，但 ",["CODE",{},"typeof"]," 一个处于 TDZ 的绑定仍会报错。",["CODE",{},"typeof"]," 不是绕过初始化规则的通行证。",["CODE",{},"const"]," 声明后的约束则是不能重新赋值，和 TDZ 是两个阶段的规则；它也不会自动冻结对象，见 ",["A",{"href":"/knowledge/materials/js-03-types-equality-copy-immutability.md/js-03#%E8%B5%8B%E5%80%BC%E4%B9%8B%E5%90%8E%E8%B0%81%E5%92%8C%E8%B0%81%E5%85%B1%E7%94%A8%E5%AF%B9%E8%B1%A1"},"JS-03 中的共享对象",["SPAN",{"class":"material-reading-badge","data-state":"unread"},"未读"]],"。"],"\n",["P",{},"脚本与模块的顶层也要区分。在浏览器传统脚本中，顶层 ",["CODE",{},"var"]," 通常会成为全局对象的属性，顶层 ",["CODE",{},"let"],"、",["CODE",{},"const"]," 则不会；ES Module 的顶层声明属于模块自己的作用域，不会自动成为 ",["CODE",{},"window"]," 的属性。因此，“能直接读到一个名字”和“能从 ",["CODE",{},"window"]," 读到同名属性”不能画等号。控制台还有自己的输入处理方式，判断工程代码时应以它实际作为脚本还是模块加载为准。"],"\n",["H3",{"id":"闭包让函数继续访问创建处的变量"},"闭包让函数继续访问创建处的变量"],"\n",["P",{},"现在把函数当作返回值，让它在外层函数结束后再执行："],"\n",["DIV",{"class":"code-block","data-language":"js"},["DIV",{"class":"code-block__bar"},["SPAN",{},"js"],["BUTTON",{"type":"button","class":"code-copy"},"复制代码"]],["PRE",{"class":"hljs"},["CODE",{},["SPAN",{"class":"hljs-keyword"},"function"]," ",["SPAN",{"class":"hljs-title function_"},"createCounter"],"(",["SPAN",{"class":"hljs-params"}],") {\n  ",["SPAN",{"class":"hljs-keyword"},"let"]," count = ",["SPAN",{"class":"hljs-number"},"0"],";\n  ",["SPAN",{"class":"hljs-keyword"},"return"]," ",["SPAN",{"class":"hljs-keyword"},"function"]," ",["SPAN",{"class":"hljs-title function_"},"next"],"(",["SPAN",{"class":"hljs-params"}],") {\n    count += ",["SPAN",{"class":"hljs-number"},"1"],";\n    ",["SPAN",{"class":"hljs-keyword"},"return"]," count;\n  };\n}\n\n",["SPAN",{"class":"hljs-keyword"},"const"]," next = ",["SPAN",{"class":"hljs-title function_"},"createCounter"],"();\n",["SPAN",{"class":"hljs-variable language_"},"console"],".",["SPAN",{"class":"hljs-title function_"},"log"],"(",["SPAN",{"class":"hljs-title function_"},"next"],"()); ",["SPAN",{"class":"hljs-comment"},"// => 1"],"\n",["SPAN",{"class":"hljs-variable language_"},"console"],".",["SPAN",{"class":"hljs-title function_"},"log"],"(",["SPAN",{"class":"hljs-title function_"},"next"],"()); ",["SPAN",{"class":"hljs-comment"},"// => 2"],"\n"]],"\n"],["P",{},["CODE",{},"createCounter()"]," 结束后，我们拿到了 ",["CODE",{},"next"]," 这个函数。稍后调用 ",["CODE",{},"next()"],"，它仍然可以找到创建时所在作用域中的 ",["CODE",{},"count"],"，并继续修改它。"],"\n",["P",{},["STRONG",{},"闭包（closure",["BUTTON",{"type":"button","class":"pronunciation-button","data-pronunciation-term":"closure","data-pronunciation-src":"/pronunciation/b01/6d4cb937d6d22521.wav","aria-label":"播放“closure”的美式发音","title":"播放“closure”的美式发音"},["SPAN",{"aria-hidden":"true"},"🔊"]],"）"]," 指的就是函数以及它能够访问的词法环境这一组合。函数创建时就确定了向外查找变量的关系。把函数返回，只是让这种关系在外层调用结束以后表现得特别明显；事件回调、数组回调里的函数，同样可以形成闭包。"],"\n",["P",{},"这里有两个动作不要混在一起：调用 ",["CODE",{},"createCounter()"]," 建立这一份 ",["CODE",{},"count"],"；调用返回的 ",["CODE",{},"next()"]," 使用这一份 ",["CODE",{},"count"],"。第二次执行 ",["CODE",{},"next()"]," 不会重新执行外层的 ",["CODE",{},"let count = 0"],"，所以输出会接着增长。"],"\n",["P",{},"这也解释了为什么“调用结束”不等于“所有局部状态立刻消失”。调用栈上的执行过程可以结束，而仍被函数引用的环境继续存在。引擎可以对存储方式做优化；理解语义时，只需关心这些变量是否仍然能被访问，不必假设整个栈帧原封不动地保存着。"],"\n",["H3",{"id":"闭包保存的是变量还是快照"},"闭包保存的是变量还是快照"],"\n",["P",{},"闭包不是在创建函数时，把外层所有值拍一张照片。它会在执行时读取相应的绑定，所以能看到后来发生的重新赋值。"],"\n",["DIV",{"class":"code-block","data-language":"js"},["DIV",{"class":"code-block__bar"},["SPAN",{},"js"],["BUTTON",{"type":"button","class":"code-copy"},"复制代码"]],["PRE",{"class":"hljs"},["CODE",{},["SPAN",{"class":"hljs-keyword"},"let"]," currentName = ",["SPAN",{"class":"hljs-string"},"'未登录'"],";\n",["SPAN",{"class":"hljs-keyword"},"const"]," ",["SPAN",{"class":"hljs-title function_"},"readName"]," = (",["SPAN",{"class":"hljs-params"}],") => currentName;\n",["SPAN",{"class":"hljs-keyword"},"const"]," savedName = currentName;\n",["SPAN",{"class":"hljs-keyword"},"const"]," ",["SPAN",{"class":"hljs-title function_"},"readSavedName"]," = (",["SPAN",{"class":"hljs-params"}],") => savedName;\n\ncurrentName = ",["SPAN",{"class":"hljs-string"},"'小林'"],";\n",["SPAN",{"class":"hljs-variable language_"},"console"],".",["SPAN",{"class":"hljs-title function_"},"log"],"(",["SPAN",{"class":"hljs-title function_"},"readName"],"()); ",["SPAN",{"class":"hljs-comment"},"// => 小林"],"\n",["SPAN",{"class":"hljs-variable language_"},"console"],".",["SPAN",{"class":"hljs-title function_"},"log"],"(",["SPAN",{"class":"hljs-title function_"},"readSavedName"],"()); ",["SPAN",{"class":"hljs-comment"},"// => 未登录"],"\n"]],"\n"],["P",{},"两个函数都用到了闭包。差别在于 ",["CODE",{},"readName"]," 读取会变化的 ",["CODE",{},"currentName"],"，而 ",["CODE",{},"readSavedName"]," 读取另外建立的 ",["CODE",{},"savedName"],"。后者保存的是当时的字符串值，之后没有被重新赋值。"],"\n",["P",{},"如果把字符串换成对象，",["CODE",{},"const saved = currentObject"]," 只会保存同一个对象的引用，不会复制对象内容。闭包没有替你完成深拷贝。遇到“为什么保存了旧状态却仍然变了”，应同时检查变量绑定和对象是否共享，接着看 ",["A",{"href":"/knowledge/materials/js-03-types-equality-copy-immutability.md/js-03#%E6%B5%85%E6%8B%B7%E8%B4%9D%E5%8F%AA%E5%A4%8D%E5%88%B6%E4%B8%80%E5%B1%82"},"JS-03：浅拷贝只复制一层",["SPAN",{"class":"material-reading-badge","data-state":"unread"},"未读"]],"。"],"\n",["P",{},"反过来，闭包也不会自动跟随所有“最新状态”。如果某次调用先算出一个字符串，再让回调读取这个字符串，回调读取的就是那次计算结果。决定它是新是旧的，不是“用了闭包”四个字，而是它实际捕获哪个绑定、该绑定以后是否更新。"],"\n",["H3",{"id":"两次创建会得到两份独立状态"},"两次创建会得到两份独立状态"],"\n",["P",{},"同一次外层调用中创建的多个函数，可以共同使用同一组局部变量。再次调用外层函数，则会建立另一份。"],"\n",["DIV",{"class":"code-block","data-language":"js"},["DIV",{"class":"code-block__bar"},["SPAN",{},"js"],["BUTTON",{"type":"button","class":"code-copy"},"复制代码"]],["PRE",{"class":"hljs"},["CODE",{},["SPAN",{"class":"hljs-keyword"},"function"]," ",["SPAN",{"class":"hljs-title function_"},"createCounter"],"(",["SPAN",{"class":"hljs-params"}],") {\n  ",["SPAN",{"class":"hljs-keyword"},"let"]," count = ",["SPAN",{"class":"hljs-number"},"0"],";\n  ",["SPAN",{"class":"hljs-keyword"},"return"]," {\n    ",["SPAN",{"class":"hljs-title function_"},"increment"],"(",["SPAN",{"class":"hljs-params"}],") { count += ",["SPAN",{"class":"hljs-number"},"1"],"; },\n    ",["SPAN",{"class":"hljs-title function_"},"read"],"(",["SPAN",{"class":"hljs-params"}],") { ",["SPAN",{"class":"hljs-keyword"},"return"]," count; },\n  };\n}\n\n",["SPAN",{"class":"hljs-keyword"},"const"]," first = ",["SPAN",{"class":"hljs-title function_"},"createCounter"],"();\n",["SPAN",{"class":"hljs-keyword"},"const"]," second = ",["SPAN",{"class":"hljs-title function_"},"createCounter"],"();\nfirst.",["SPAN",{"class":"hljs-title function_"},"increment"],"();\nfirst.",["SPAN",{"class":"hljs-title function_"},"increment"],"();\n",["SPAN",{"class":"hljs-variable language_"},"console"],".",["SPAN",{"class":"hljs-title function_"},"log"],"(first.",["SPAN",{"class":"hljs-title function_"},"read"],"()); ",["SPAN",{"class":"hljs-comment"},"// => 2"],"\n",["SPAN",{"class":"hljs-variable language_"},"console"],".",["SPAN",{"class":"hljs-title function_"},"log"],"(second.",["SPAN",{"class":"hljs-title function_"},"read"],"()); ",["SPAN",{"class":"hljs-comment"},"// => 0"],"\n"]],"\n"],["P",{},["CODE",{},"first.increment"]," 和 ",["CODE",{},"first.read"]," 是两个函数，但它们读取同一份 ",["CODE",{},"count"],"。",["CODE",{},"second"]," 的两个方法来自第二次外层调用，使用另一份 ",["CODE",{},"count"],"。这是一种简单的封装方式：外部只能通过提供的方法访问状态，不能直接用 ",["CODE",{},"first.count"]," 修改局部变量。"],"\n",["P",{},"这种封装并不保证所有返回的数据都安全。如果 ",["CODE",{},"read()"]," 返回一个内部可变对象，外部拿到它仍可能改动内部状态；“变量名不可直接访问”和“对象不可修改”是两回事。也不要在外层模块只创建一次实例，再误以为每个使用者拿到的都是新状态。需要隔离时，应明确在哪里调用创建函数。"],"\n",["P",{},"此处的方法没有用到 ",["CODE",{},"this"],"，把 ",["CODE",{},"first.read"]," 取出来单独调用也能工作。它读取的是词法环境里的 ",["CODE",{},"count"],"。如果方法写成 ",["CODE",{},"return this.count"],"，决定结果的就变成了调用方式；这个区别在 ",["A",{"href":"/knowledge/materials/js-02-prototype-object-model-this.md/js-02#%E5%85%88%E6%89%BE%E5%88%B0%E5%87%BD%E6%95%B0%E5%86%8D%E7%9C%8B%E6%80%8E%E6%A0%B7%E8%B0%83%E7%94%A8"},"JS-02：先找到函数再看怎样调用",["SPAN",{"class":"material-reading-badge","data-state":"unread"},"未读"]],"中展开。"],"\n",["H3",{"id":"循环中的回调为什么会读到同一个数"},"循环中的回调为什么会读到同一个数"],"\n",["P",{},"闭包问题不一定要等待定时器才出现。先把函数放进数组，再在循环结束后调用，就能把变量问题单独看清楚。"],"\n",["DIV",{"class":"code-block","data-language":"js"},["DIV",{"class":"code-block__bar"},["SPAN",{},"js"],["BUTTON",{"type":"button","class":"code-copy"},"复制代码"]],["PRE",{"class":"hljs"},["CODE",{},["SPAN",{"class":"hljs-keyword"},"const"]," shared = [];\n",["SPAN",{"class":"hljs-keyword"},"for"]," (",["SPAN",{"class":"hljs-keyword"},"var"]," index = ",["SPAN",{"class":"hljs-number"},"0"],"; index < ",["SPAN",{"class":"hljs-number"},"3"],"; index += ",["SPAN",{"class":"hljs-number"},"1"],") {\n  shared.",["SPAN",{"class":"hljs-title function_"},"push"],"(",["SPAN",{"class":"hljs-function"},"() =>"]," index);\n}\n",["SPAN",{"class":"hljs-variable language_"},"console"],".",["SPAN",{"class":"hljs-title function_"},"log"],"(shared.",["SPAN",{"class":"hljs-title function_"},"map"],"(",["SPAN",{"class":"hljs-function"},"(",["SPAN",{"class":"hljs-params"},"read"],") =>"]," ",["SPAN",{"class":"hljs-title function_"},"read"],"()).",["SPAN",{"class":"hljs-title function_"},"join"],"(",["SPAN",{"class":"hljs-string"},"','"],")); ",["SPAN",{"class":"hljs-comment"},"// => 3,3,3"],"\n\n",["SPAN",{"class":"hljs-keyword"},"const"]," separate = [];\n",["SPAN",{"class":"hljs-keyword"},"for"]," (",["SPAN",{"class":"hljs-keyword"},"let"]," index = ",["SPAN",{"class":"hljs-number"},"0"],"; index < ",["SPAN",{"class":"hljs-number"},"3"],"; index += ",["SPAN",{"class":"hljs-number"},"1"],") {\n  separate.",["SPAN",{"class":"hljs-title function_"},"push"],"(",["SPAN",{"class":"hljs-function"},"() =>"]," index);\n}\n",["SPAN",{"class":"hljs-variable language_"},"console"],".",["SPAN",{"class":"hljs-title function_"},"log"],"(separate.",["SPAN",{"class":"hljs-title function_"},"map"],"(",["SPAN",{"class":"hljs-function"},"(",["SPAN",{"class":"hljs-params"},"read"],") =>"]," ",["SPAN",{"class":"hljs-title function_"},"read"],"()).",["SPAN",{"class":"hljs-title function_"},"join"],"(",["SPAN",{"class":"hljs-string"},"','"],")); ",["SPAN",{"class":"hljs-comment"},"// => 0,1,2"],"\n"]],"\n"],["P",{},"第一轮循环使用 ",["CODE",{},"var"],"。所有回调共享同一个 ",["CODE",{},"index"],"；等我们真正调用它们时，循环已经结束，这个变量的值是 ",["CODE",{},"3"],"。"],"\n",["P",{},"第二轮在 ",["CODE",{},"for"]," 头部使用 ",["CODE",{},"let"],"。JavaScript 为迭代建立各自的绑定，因此每个回调关联自己那一轮的 ",["CODE",{},"index"],"。这不是因为箭头函数能自动记住当前数字，两组代码都用了箭头函数；变化的是绑定的创建规则。"],"\n",["P",{},"如果必须处理使用 ",["CODE",{},"var"]," 的旧代码，可以在每一轮调用一个普通函数，把当前值作为参数传进去，让这次调用建立单独的参数绑定。原理和 ",["CODE",{},"createCounter"]," 完全一致，不需要再背一套神秘口诀。若问题来自定时器，把“何时执行”交给",["A",{"href":"/knowledge/materials/javascript-scheduled-callbacks.md/prejs-04"},"稍后执行的回调",["SPAN",{"class":"material-reading-badge","data-state":"unread"},"未读"]],"，把“届时读哪个变量”留给作用域分析，两条线各自推清就够了。"],"\n",["H3",{"id":"回调结束使用后要解除谁的引用"},"回调结束使用后要解除谁的引用"],"\n",["P",{},"闭包本身不是内存泄漏。一个计数器刻意保存 ",["CODE",{},"count"],"，就是它正常工作的方式。真正值得留意的是：业务已经不再需要回调，但事件系统、定时器或长期存在的集合仍然保存着它。"],"\n",["P",{},"下面使用标准 ",["CODE",{},"EventTarget"]," 模拟一个通知来源，不需要页面上预先存在按钮。订阅函数返回清理函数，让登记和撤销写在一起。"],"\n",["DIV",{"class":"code-block","data-language":"js"},["DIV",{"class":"code-block__bar"},["SPAN",{},"js"],["BUTTON",{"type":"button","class":"code-copy"},"复制代码"]],["PRE",{"class":"hljs"},["CODE",{},["SPAN",{"class":"hljs-keyword"},"const"]," events = ",["SPAN",{"class":"hljs-keyword"},"new"]," ",["SPAN",{"class":"hljs-title class_"},"EventTarget"],"();\n\n",["SPAN",{"class":"hljs-keyword"},"function"]," ",["SPAN",{"class":"hljs-title function_"},"subscribeLabel"],"(",["SPAN",{"class":"hljs-params"},"label"],") {\n  ",["SPAN",{"class":"hljs-keyword"},"function"]," ",["SPAN",{"class":"hljs-title function_"},"onChange"],"(",["SPAN",{"class":"hljs-params"}],") {\n    ",["SPAN",{"class":"hljs-variable language_"},"console"],".",["SPAN",{"class":"hljs-title function_"},"log"],"(label); ",["SPAN",{"class":"hljs-comment"},"// => 草稿已保存"],"\n  }\n  events.",["SPAN",{"class":"hljs-title function_"},"addEventListener"],"(",["SPAN",{"class":"hljs-string"},"'change'"],", onChange);\n  ",["SPAN",{"class":"hljs-keyword"},"return"]," ",["SPAN",{"class":"hljs-function"},"() =>"]," events.",["SPAN",{"class":"hljs-title function_"},"removeEventListener"],"(",["SPAN",{"class":"hljs-string"},"'change'"],", onChange);\n}\n\n",["SPAN",{"class":"hljs-keyword"},"const"]," stop = ",["SPAN",{"class":"hljs-title function_"},"subscribeLabel"],"(",["SPAN",{"class":"hljs-string"},"'草稿已保存'"],");\nevents.",["SPAN",{"class":"hljs-title function_"},"dispatchEvent"],"(",["SPAN",{"class":"hljs-keyword"},"new"]," ",["SPAN",{"class":"hljs-title class_"},"Event"],"(",["SPAN",{"class":"hljs-string"},"'change'"],"));\n",["SPAN",{"class":"hljs-title function_"},"stop"],"();\nevents.",["SPAN",{"class":"hljs-title function_"},"dispatchEvent"],"(",["SPAN",{"class":"hljs-keyword"},"new"]," ",["SPAN",{"class":"hljs-title class_"},"Event"],"(",["SPAN",{"class":"hljs-string"},"'change'"],"));\n"]],"\n"],["P",{},"第一次派发事件，监听器读取闭包中的 ",["CODE",{},"label"],"。调用 ",["CODE",{},"stop()"]," 后，事件源不再保存这条监听，第二次派发不会输出。清理时使用的是原来的 ",["CODE",{},"onChange"]," 函数；重新写一个内容相同的函数，会得到另一个函数对象，无法替代它。"],"\n",["P",{},"还要继续问一层：我们是否仍把 ",["CODE",{},"stop"]," 放在一个长期存在的数组中？清理函数自身也可能引用 ",["CODE",{},"onChange"],"。移除监听会断开事件源这一条引用，但其他引用若仍存在，对应对象仍可能保持可达。因此，清理完成后也应让过期订阅记录退出自己的集合。垃圾回收取决于对象是否仍然可达，而且不会承诺在某一行代码后立即执行。"],"\n",["DIV",{"class":"markdown-callout markdown-callout--tip"},["STRONG",{},"把清理责任写在创建处"],"\n",["P",{},"凡是把函数交给一个比当前操作活得更久的系统，都顺手确认撤销入口。完整的“正常结束、提前退出、发生异常”清理模型，见 ",["A",{"href":"/knowledge/materials/js-07-iteration-metaprogramming-resources.md/js-07#%E8%AE%A9%E8%B5%84%E6%BA%90%E7%9A%84%E6%89%93%E5%BC%80%E5%92%8C%E5%85%B3%E9%97%AD%E5%BE%85%E5%9C%A8%E4%B8%80%E8%B5%B7"},"JS-07：让资源的打开和关闭待在一起",["SPAN",{"class":"material-reading-badge","data-state":"unread"},"未读"]],"。"],"\n"],"\n",["H3",{"id":"用一条线把概念连起来"},"用一条线把概念连起来"],"\n",["P",{},"分析一段涉及闭包的代码，可以按这样的次序阅读：函数在哪里定义；当前读取的名字属于哪一层作用域；那层作用域是哪次调用建立的；读取发生前，这个绑定或它指向的对象有没有变化；最后，是谁仍然持有这个函数。"],"\n",["P",{},"这条顺序比先判断“这算不算闭包”更实用。它同时解释了调用结束后的状态保留、同一实例中的共享状态、多实例隔离，以及回调的清理。调用栈帮助你跟踪执行过程，词法作用域帮助你找到变量，闭包则把函数与它仍可访问的环境连在一起。"],"\n",["P",{},"接下来读 ",["A",{"href":"/knowledge/materials/js-02-prototype-object-model-this.md/js-02"},"JS-02 原型、对象模型与 this",["SPAN",{"class":"material-reading-badge","data-state":"unread"},"未读"]],"。你会遇到另一种容易混淆的查找：",["CODE",{},"name"]," 沿作用域找变量，",["CODE",{},"object.name"]," 沿对象及其原型找属性。先把两条路径分开，再看它们如何在方法调用中碰面。"],"\n",["H3",{"id":"参考与延伸阅读"},"参考与延伸阅读"],"\n",["UL",{},"\n",["LI",{},["A",{"href":"https://developer.mozilla.org/en-US/docs/Web/JavaScript/Guide/Closures","target":"_blank","rel":"noopener noreferrer"},"MDN：Closures"],"——查阅词法环境、闭包共享状态和循环回调的更多说明。"],"\n",["LI",{},["A",{"href":"https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Execution_model","target":"_blank","rel":"noopener noreferrer"},"MDN：JavaScript execution model"],"——进一步了解执行上下文、调用栈与宿主环境的关系。"],"\n",["LI",{},["A",{"href":"https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Statements/let","target":"_blank","rel":"noopener noreferrer"},"MDN：let"],"——核对 TDZ 和 ",["CODE",{},"for"]," 循环的逐轮绑定规则。"],"\n",["LI",{},["A",{"href":"https://developer.mozilla.org/en-US/docs/Web/JavaScript/Guide/Memory_management","target":"_blank","rel":"noopener noreferrer"},"MDN：Memory management"],"——需要定位长期保留的数据时，再深入可达性和垃圾回收。"],"\n"],"\n"]],["NAV",{"data-v-02f53d77":"","class":"chapter-pagination","aria-label":"继续学习"},["A",{"data-v-02f53d77":"","href":"/knowledge/materials/js-02-prototype-object-model-this.md/js-02","class":""},["SMALL",{"data-v-02f53d77":""},"同组下一篇 →"],["STRONG",{"data-v-02f53d77":""},"原型与 this"]]],["FOOTER",{"data-v-02f53d77":""},["SPAN",{"data-v-02f53d77":""},"正文阅读超过 80% 仅标记资料看完，不改变知识点状态"],["BUTTON",{"data-v-02f53d77":"","type":"button"},"返回上一页 →"]],["SPAN",{"data-v-02f53d77":"