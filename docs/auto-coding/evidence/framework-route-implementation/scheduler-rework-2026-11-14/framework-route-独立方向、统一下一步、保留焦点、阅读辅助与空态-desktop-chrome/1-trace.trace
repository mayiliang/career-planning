#5f6d7e;\n  --color-text-tertiary: #8995a4;\n  --color-focus: rgba(50,104,199,.18);\n  --color-blueprint: var(--color-primary);\n  --color-cool-sheet: var(--color-background);\n  --color-draft-ink: var(--color-text);\n  --color-moss-proof: var(--color-success);\n  --color-amber-review: var(--color-warning);\n  --color-redline: var(--color-danger);\n  --color-editorial-ink: #19312a;\n  --color-editorial-moss: #176a55;\n  --color-editorial-clay: #c2603f;\n  --color-editorial-paper: #fffefa;\n  --font-display: \"Avenir Next\", \"SF Pro Display\", \"PingFang SC\", sans-serif;\n  --font-body: Inter, \"SF Pro Text\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;\n  --font-mono: \"SFMono-Regular\", \"JetBrains Mono\", Consolas, monospace;\n  --space-base: 8px;\n  --space-xs: 4px;\n  --space-sm: 8px;\n  --space-md: 16px;\n  --space-lg: 24px;\n  --space-xl: 32px;\n  --radius-base: 12px;\n  --radius-sm: 8px;\n  --radius-md: 12px;\n  --radius-lg: 16px;\n  --radius-full: 999px;\n  --shadow-xs: 0 1px 2px rgba(26,42,67,.04);\n  --shadow-sm: 0 10px 30px rgba(26,42,67,.08);\n  --shadow-md: 0 22px 64px rgba(26,42,67,.14);\n  /* 兼容各业务页的语义变量，避免未定义变量让间距、圆角和状态色静默失效。 */\n  --surface-primary: var(--color-surface);\n  --surface-secondary: var(--color-surface-raised);\n  --surface-tertiary: #eef2f7;\n  --text-secondary: var(--color-text-secondary);\n  --text-tertiary: var(--color-text-tertiary);\n  --border-color: var(--color-border);\n  --color-bg-primary: var(--color-surface);\n  --color-error: var(--color-danger);\n  --color-warning-bg: #fff7e7;\n}\n* { box-sizing: border-box;\n}\nhtml { color-scheme: light; background: var(--color-background);\n}\nhtml,body,#app { min-height: 100%; margin: 0;\n}\nbody { font-family: var(--font-body); color: var(--color-text); line-height: 1.6; background:var(--color-background); -webkit-font-smoothing: antialiased;\n}\nbutton,input,textarea,select { font: inherit;\n}\nbutton { transition: transform .18s ease, color .18s ease, background .18s ease, border-color .18s ease, box-shadow .18s ease;\n}\nbutton:disabled { cursor: not-allowed;\n}\nbutton:not(:disabled):active { transform: translateY(1px) scale(.99);\n}\nbutton:focus-visible,a:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible { outline: 3px solid var(--color-focus); outline-offset: 2px;\n}\n::selection { color: var(--color-navy); background: #cfe0ff;\n}\n.sr-only { position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important;\n}\n\n/* 全局框架：安静的背景、清晰的导航与可收起的阅读空间。 */\n.app-root { display: grid; grid-template-columns: 224px minmax(0, 1fr); min-height: 100vh;\n}\n.app-root.sidebar-collapsed { grid-template-columns: 80px minmax(0, 1fr);\n}\n.skip-link { position: fixed; top: 10px; left: 10px; z-index: 5000; padding: 10px 16px; color: #fff; background: var(--color-navy); border-radius: 10px; transform: translateY(-160%);\n}\n.skip-link:focus { transform: translateY(0);\n}\n.side-nav { position: sticky; top: 0; z-index: 30; display: flex; flex-direction: column; height: 100vh; height: 100dvh; padding: 28px 16px 18px; background: #fcfdfd; border-right: 1px solid #e1e7ec; overflow-y: auto;\n}\n.nav-header { display: flex; align-items: center; gap: 10px; padding: 0 6px 36px;\n}\n.brand-mark { flex: 0 0 36px; width: 36px; height: 36px; border-radius: 11px;\n}\n.brand-copy { min-width: 0;\n}\n.app-title { color: #1a3044; font: 750 16px/1.3 var(--font-display); letter-spacing: -.025em; white-space: nowrap;\n}\n.brand-copy p { margin: 4px 0 0; color: #74818f; font-size: 10px; white-space: nowrap;\n}\n.nav-caption { margin: 0 14px 12px; color: #7a8795; font-size: 11px; letter-spacing: .08em;\n}\n.nav-list { display: grid; align-content: start; gap: 7px; margin: 0; padding: 0; list-style: none;\n}\n.nav-link { position: relative; display: flex; align-items: center; gap: 12px; min-height: 48px; padding: 8px 13px; color: #617080; text-decoration: none; border: 1px solid transparent; border-radius: 10px; transition: background .18s, color .18s, border-color .18s;\n}\n.nav-link:hover { color: #203d5c; background: #f0f4f8;\n}\n.nav-link.active { color: #285799; background: #eaf1fc; border-color: #dce7f7;\n}\n.nav-link.active::after { content: ''; position: absolute; right: 12px; width: 5px; height: 5px; background: #4b7cc2; border-radius: 50%;\n}\n.nav-glyph { display: grid; flex: 0 0 22px; place-items: center;\n}\n.nav-copy { min-width: 0;\n}\n.nav-copy strong { font-size: 13px; font-weight: 600;\n}\n.nav-footer { display: grid; gap: 20px; margin-top: auto; padding-top: 32px;\n}\n.service-state { display: flex; align-items: center; gap: 10px; margin: 0 9px; padding: 16px 4px 0; border-top: 1px solid #e4e9ee;\n}\n.service-state > span { flex: 0 0 6px; width: 6px; height: 6px; border-radius: 50%; box-shadow: 0 0 0 4px #edf5f1;\n}\n.service-state div { display: grid; gap: 3px;\n}\n.service-state strong { font-size: 11px; color: #566779; font-weight: 500;\n}\n.service-state small { color: #7a8795; font-size: 10px;\n}\n.main-area { min-width: 0;\n}\n.workspace-bar { height: 72px; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 0 clamp(20px, 2.7vw, 44px); border-bottom: 1px solid #e3e8ee; background: rgba(252, 253, 253, .9);\n}\n.workspace-location, .workspace-tools { display: flex; align-items: center; gap: 14px; min-width: 0;\n}\n.workspace-location { font-size: 12px;\n}\n.workspace-label, .breadcrumb-divider { color: #8793a1;\n}\n.current-location { color: #40556a; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;\n}\n.icon-button { display: grid; place-items: center; width: 36px; height: 36px; flex-shrink: 0; padding: 0; color: #6a7a8b; background: transparent; border: 1px solid transparent; border-radius: 8px; cursor: pointer;\n}\n.icon-button:hover { color: var(--color-primary); background: #edf2f8; bord