rap: anywhere;\n}\n.markdown-body[data-v-0b0b9f63] { min-width: 0;\n}\n.markdown-body[data-v-0b0b9f63] > :first-child, .thinking-panel__content[data-v-0b0b9f63] > :first-child { margin-top: 0;\n}\n.markdown-body[data-v-0b0b9f63] > :last-child, .thinking-panel__content[data-v-0b0b9f63] > :last-child { margin-bottom: 0;\n}\n.markdown-renderer[data-v-0b0b9f63] h1, .markdown-renderer[data-v-0b0b9f63] h2, .markdown-renderer[data-v-0b0b9f63] h3, .markdown-renderer[data-v-0b0b9f63] h4 { color: #10241d; line-height: 1.3; margin: 1.55em 0 .68em; letter-spacing: -.02em; scroll-margin-top: 5rem;\n}\n.markdown-renderer[data-v-0b0b9f63] h1 { font-size: 2em; padding-bottom: .4em; border-bottom: 1px solid #dce4df;\n}\n.markdown-renderer[data-v-0b0b9f63] h2 { font-size: 1.52em;\n}\n.markdown-renderer[data-v-0b0b9f63] h3 { font-size: 1.24em;\n}\n.markdown-renderer[data-v-0b0b9f63] p, .markdown-renderer[data-v-0b0b9f63] ul, .markdown-renderer[data-v-0b0b9f63] ol, .markdown-renderer[data-v-0b0b9f63] blockquote, .markdown-renderer[data-v-0b0b9f63] table, .markdown-renderer[data-v-0b0b9f63] pre { margin: .82em 0;\n}\n.markdown-renderer[data-v-0b0b9f63] ul, .markdown-renderer[data-v-0b0b9f63] ol { padding-left: 1.6em;\n}\n.markdown-renderer[data-v-0b0b9f63] li + li { margin-top: .28em;\n}\n.markdown-renderer[data-v-0b0b9f63] a { color: #096c59; text-decoration-thickness: .08em; text-underline-offset: .2em;\n}\n.markdown-renderer[data-v-0b0b9f63] a:hover { color: #b34b2d;\n}\n.markdown-renderer[data-v-0b0b9f63] a[target=\"_blank\"]::after { content: \" ↗\"; font-size: .75em; text-decoration: none;\n}\n.markdown-renderer[data-v-0b0b9f63] blockquote { padding: .7em 1em; border-left: 4px solid #5c8c7c; background: #f3f7f5; color: #4d615a; border-radius: 0 10px 10px 0;\n}\n.markdown-renderer[data-v-0b0b9f63] code:not(pre code) { padding: .14em .38em; border: 1px solid #dde6e1; border-radius: 5px; background: #f3f6f4; color: #a2422b; font-size: .9em;\n}\n.markdown-renderer[data-v-0b0b9f63] pre